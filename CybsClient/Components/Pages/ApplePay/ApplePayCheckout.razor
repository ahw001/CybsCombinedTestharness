@rendermode @(new InteractiveServerRenderMode(prerender: false))
@page "/applepaycheckout"
@implements IDisposable

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ICartService cartService
@inject ISessionTransactions sessionTransactions

<title>Apple Pay Checkout</title>

@* Apple's own SDK — supplies the <apple-pay-button> custom element used below. Without it that
   tag is an unknown element with no shadow DOM and renders as a 0x0 invisible box, so there is
   literally nothing for the customer to tap. Loaded from Apple's CDN exactly as their integration
   guide specifies (same pattern as the CyberSource Flex/Unified Checkout scripts on their pages). *@
<script crossorigin="anonymous" src="https://applepay.cdn-apple.com/jsapi/v1/apple-pay-sdk.js"></script>
<script src="Components/Pages/ApplePay/ApplePayCheckout.razor.js"></script>

@* Apple's official Apple Pay button chrome (-webkit-appearance: -apple-pay-button) is OS-rendered
   button styling mandated by Apple's Human Interface Guidelines — it cannot be expressed with
   Bootstrap classes, so (unlike the rest of this app's UI) it is defined here directly, exactly
   as Apple's own integration guide recommends. See CLAUDE.md's app.css convention for the
   sidebar's own narrow exception to "no inline/scoped CSS" for the same reason (a component that
   Bootstrap has no equivalent for). *@
<style>
    apple-pay-button {
        --apple-pay-button-width: 240px;
        --apple-pay-button-height: 44px;
        --apple-pay-button-border-radius: 5px;
        --apple-pay-button-padding: 5px 0px;
        display: inline-block;
    }
</style>

<div class="py-1 text-center">
    <h2>Apple Pay Checkout</h2>
</div>

<hr class="my-4">

@* Same form UX as CheckoutForm.razor (CustomerMasterComponent + "Use Defaults" + editable
   billing/cart) but at the "Base Form" tier — sample customer data + cart data only, no card
   entry (ShowAccountDetails omitted from FormElements below). Card fields are unnecessary here:
   the card credential comes from the Apple Pay sheet, not typed input. Full card-collecting
   "Checkout" is Base Form + ShowAccountDetails; this page is deliberately the narrower tier.
   Submitting this form does not authorize yet — it captures billing/cart, then reveals the Apple
   Pay button below. *@
<div>
    <div class="row g-5">
        @if (Show)
        {
            <CustomerMasterComponent ButtonText="Continue to Apple Pay" FormElements="HomeFormElements" FormCustomer="b2CCustomer" ValidSubmit="Submit"></CustomerMasterComponent>
        }

        <FormSection>
            @if (error is not null)
            {
                <div class="col-6">
                    <strong class="alert-danger">@error</strong>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Follow on Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="applepaycheckout">New Apple Pay Checkout</a></li>
                        <li><a class="dropdown-item" href="checkout">New Checkout</a></li>
                    </ul>
                </div>
            }
        </FormSection>
    </div>

    @if (readyForApplePay)
    {
        <div class="row justify-content-center">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Billing Name</dt>
                    <dd class="col-sm-8">@b2CCustomer.FirstName @b2CCustomer.LastName</dd>
                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8">@(b2CCustomer.TotalAmount ?? 0m) @b2CCustomer.Currency</dd>
                </dl>

                @if (!applePayAvailable)
                {
                    <div class="alert alert-warning">
                        Apple Pay is not available in this browser/domain. Apple Pay JS only runs in
                        Safari on an Apple-verified HTTPS domain — see the Local Testing note in the
                        Apple Pay implementation plan.
                    </div>
                }
                else if (appleButtonChromeAvailable)
                {
                    @* No @onclick — the click is wired natively in ApplePayCheckout.razor.js so that
                       ApplePaySession is constructed inside the user-gesture handler. See the
                       USER-GESTURE CONSTRAINT note at the top of that file. *@
                    <apple-pay-button id="@ApplePayButtonElementId" buttonstyle="black" type="plain" locale="en"
                                       style="cursor:pointer;"></apple-pay-button>
                }
                else
                {
                    @* Apple's SDK never loaded (CDN blocked/offline), so the official button chrome
                       is unavailable. ApplePaySession itself is still present, so fall back to a
                       plain Bootstrap button rather than rendering an invisible element. *@
                    <button id="@ApplePayButtonElementId" type="button" class="btn btn-dark">Pay with Apple Pay</button>
                    <div class="form-text">Apple's button styling could not be loaded; using a fallback button.</div>
                }

                @if (statusMessage is not null)
                {
                    <p class="mt-3">@statusMessage</p>
                }
            </div>
        </div>
    }

    <footer class="my-5 pt-5 text-body-secondary text-center text-small">
        <p class="mb-1">&copy; 2017–2024 Company Name</p>
        <ul class="list-inline">
            <li class="list-inline-item"><a href="#">Privacy</a></li>
            <li class="list-inline-item"><a href="#">Terms</a></li>
            <li class="list-inline-item"><a href="#">Support</a></li>
        </ul>
    </footer>
</div>

@code {
    private bool Show = true;
    private bool readyForApplePay = false;

    // "Base Form" tier — sample customer data + cart data only, no card entry (no
    // "ShowAccountDetails"). Full card-collecting "Checkout" is this list + ShowAccountDetails.
    List<string> HomeFormElements = new List<string> { "ShowMainForm", "ShowBilling", "ShowDefaults", "ShowAuthCapture", "ShowCart" };

    private B2cCustomer b2CCustomer = new();
    private ISessionTransactions _sessionTransactions = new SessionTransactions();
    private SessionTransJson sessionTransJson = new();

    private bool applePayAvailable = false;
    private bool appleButtonChromeAvailable = false;
    private bool buttonWireAttempted = false;
    private string? error;
    private string? statusMessage;

    private DotNetObjectReference<ApplePayCheckout>? _dotNetRef;

    // CyberSource merchant/country codes for the payment sheet.
    private const string MerchantIdentifier = "merchant.com.ahw001.applepaycheckout";
    private const string CountryCode = "US";

    // Shared by the official Apple button and the fallback button — attachApplePayButton looks the
    // element up by this id, so whichever one renders gets the native click listener.
    private const string ApplePayButtonElementId = "applePayButton";

    protected override void OnInitialized()
    {
        if (cartService.Cart is not null && cartService.Cart.Count > 0)
        {
            b2CCustomer.Cart = cartService.Cart.ToList();
            b2CCustomer.TotalAmount = cartService.Total;
        }

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                applePayAvailable = await JSRuntime.InvokeAsync<bool>("applePayIsAvailable");

                if (applePayAvailable)
                {
                    // Waits for Apple's SDK to define <apple-pay-button>; false means the CDN never
                    // answered and the page should render the Bootstrap fallback button instead.
                    appleButtonChromeAvailable = await JSRuntime.InvokeAsync<bool>("applePayButtonElementReady", 5000);
                }
            }
            catch
            {
                applePayAvailable = false;
            }

            StateHasChanged();
            return;
        }

        // The button only exists once the form has been submitted (readyForApplePay). Wire the
        // native click listener as soon as it is in the DOM — the session must be created from the
        // real user gesture, which a Blazor @onclick round trip cannot provide.
        if (readyForApplePay && applePayAvailable && !buttonWireAttempted)
        {
            buttonWireAttempted = true;

            try
            {
                var amount = (b2CCustomer.TotalAmount ?? 0m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

                var wired = await JSRuntime.InvokeAsync<bool>("attachApplePayButton", _dotNetRef,
                    ApplePayButtonElementId, amount, b2CCustomer.Currency ?? "USD", CountryCode,
                    MerchantIdentifier, "TestCC Processor");

                if (!wired)
                {
                    statusMessage = "Apple Pay button could not be initialized.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                statusMessage = "Apple Pay button could not be initialized: " + ex.Message;
                StateHasChanged();
            }
        }
    }

    // ValidSubmit callback from CustomerMasterComponent (same "Use Defaults" + billing/cart form
    // as Checkout). Does not authorize yet — captures the populated customer and reveals the
    // Apple Pay button below, exactly like Checkout reveals its own submit outcome after the form.
    private void Submit(B2cCustomer submittedCustomer)
    {
        try
        {
            b2CCustomer = submittedCustomer;

            if (b2CCustomer.TotalAmount is null or 0m && b2CCustomer.Cart is not null)
            {
                foreach (var item in b2CCustomer.Cart)
                {
                    b2CCustomer.TotalAmount = (b2CCustomer.TotalAmount ?? 0m) + item.UnitPrice;
                }
            }

            Show = false;
            readyForApplePay = true;
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnApplePayUnavailable()
    {
        applePayAvailable = false;
        StateHasChanged();
    }

    // Surfaced from JS when ApplePaySession cannot be constructed or begun (e.g. WebKit's
    // InvalidAccessError for a lost user gesture, or an invalid payment request). Rendered on the
    // page so the failure is visible on a device without a Web Inspector attached.
    [JSInvokable]
    public void OnApplePaySessionError(string message)
    {
        statusMessage = "Apple Pay could not start: " + message;
        StateHasChanged();
    }

    // Called from JS when ApplePaySession fires onvalidatemerchant. Routes through CallMinAPIs
    // (per the app-wide HTTP gateway constraint) to the server's mutual-TLS proxy, which is the
    // only place the Merchant Identity Certificate is ever used. Returns the merchant session
    // JSON string to JS, which passes it to session.completeMerchantValidation(...); returns null
    // on failure so JS can call session.abort() instead.
    [JSInvokable]
    public async Task<string?> OnMerchantValidationNeeded(string validationUrl)
    {
        var result = await CallMinAPIs.ValidateApplePayMerchantAsync(validationUrl);

        if (!result.IsSuccess || result.Data is null)
        {
            statusMessage = "Merchant validation failed: " + (result.Error?.Message ?? result.Error?.Error ?? "unknown error");
            StateHasChanged();
            return null;
        }

        return result.Data.ToJsonString();
    }

    [JSInvokable]
    public void OnApplePayCancelled()
    {
        statusMessage = "Apple Pay sheet cancelled.";
        StateHasChanged();
    }

    // Called from JS with the raw (still-encrypted) paymentData JSON + card network string from
    // the Apple Pay sheet's onpaymentauthorized event. Decryption happens server-side — see
    // ApplePayDecryptor / CallForApplePayAuth on CyberSourceServer. Returns true/false to JS so it
    // can call session.completePayment(STATUS_SUCCESS/STATUS_FAILURE) correctly.
    [JSInvokable]
    public async Task<bool> OnApplePayAuthorized(string paymentDataJson, string network)
    {
        try
        {
            b2CCustomer.ApplePayPaymentData = paymentDataJson;
            b2CCustomer.ApplePayCardNetwork = network;

            if (b2CCustomer.ActionTokenTypes is null)
            {
                b2CCustomer.ActionTokenTypes = new string[] { "paymentInstrument" };
            }

            var options = new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(b2CCustomer, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.APPLE_PAY_AUTH);

            if (sessionResponse is null || sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse, "Apple Pay authorization failed.");
                return false;
            }

            sessionTransactions.AddTrans(sessionResponse);
            cartService.DeleteAll();
            Navigation.NavigateTo("/processauth");
            return true;
        }
        catch (Exception ex)
        {
            HandleErrorAndRedirect(null, "Error: " + ex.Message);
            return false;
        }
    }

    private void HandleErrorAndRedirect(SessionTransJson? response, string fallbackErrorMessage)
    {
        Show = false;
        readyForApplePay = false;
        StateHasChanged();

        var errorMessage = response?.error ?? fallbackErrorMessage;
        var errorJsonState = response?.JsonTransactionStateValues ?? TransactionStateValues.Error;

        var errorResponse = response ?? new SessionTransJson
        {
            JsonTransactionStateValues = errorJsonState,
            error = errorMessage,
            TransactionStatus = "error"
        };

        sessionTransactions.AddTrans(errorResponse);
        Navigation.NavigateTo("/errorhandler");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
