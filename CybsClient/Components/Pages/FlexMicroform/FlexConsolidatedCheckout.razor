@page "/flexconsolidatedcheckout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@* ============================================================================
   Consolidated Flex Checkout Flow — a single-page, single-circuit rewrite of
   the legacy 10-page chain:
     /flexcheckout -> /flexprocessor -> /flexform -> /processfollowon
       -> /padatacollect -> /pacheckenroll -> /paprocessor -> /pastepup
       -> /stepup-complete -> /processfollowon

   This is an ADDITIVE, NEW page. None of the legacy pages/components listed
   above are modified. All server endpoints and DTOs are reused unchanged
   (same CcTransactionTypes routed through CallMinAPIs.SubmitForFollowOn).

   Stages (see Stage enum below) render inline except for two, which use the
   established "modal d-block" overlay pattern from
   Components/Pages/Boarding/BoardingDashboard.razor:
     - CardEntry   : Flex Microform card capture (PAN/CVV/expiry + tokenize)
     - Challenge   : 3DS step-up ACS iframe

   Because no stage ever calls NavigateTo/forceLoad, the Blazor circuit is
   never destroyed, so the SESSION_STATE_STORE/RETRIEVE GUID round-trip that
   the legacy pastepup/stepup-complete pages use only to survive the old
   circuit-breaking redirect is not needed here — all state stays in memory.
   ============================================================================ *@

@inject IJSRuntime JSRuntime
@inject IHttpClientFactory httpClientFactory
@inject ICartService cartService
@inject ICustomersScoped customersScoped
@inject ITransactionJson transactionJson
@inject NavigationManager Navigation
@inject ISessionTransactions sessionTransactions
@inject ICtxContext ctxContext
@inject ITransientToken diTransientToken
@inject ClientIpService clientIpService
@inject ITransactionModeState transactionModeState
@inject ICardService cardService
@inject IPayerAuthTestCardService payerAuthTestCardService
@inject INetworkTokenTestCardService networkTokenTestCardService

<h3>Flex Checkout (Consolidated)</h3>

@* ── Stage progress indicator ─────────────────────────────────────────────── *@
<ul class="nav nav-pills mb-4">
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.CustomerEntry)">1. Customer</span></li>
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.CardEntry)">2. Card</span></li>
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.DeviceCollect)">3. Device Check</span></li>
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.EnrollReview)">4. 3DS Enrollment</span></li>
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.Challenge)">5. Verify</span></li>
    <li class="nav-item"><span class="nav-link @StageBadge(Stage.Result)">6. Result</span></li>
</ul>

@* ── Stage: CustomerEntry (inline) ────────────────────────────────────────── *@
@if (stage == Stage.CustomerEntry)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Transaction Type</h5>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="flexcxTransactionMode" id="flexcxModeStandard"
                       checked="@(transactionModeState.Mode == TransactionMode.Standard)"
                       @onchange="@(() => transactionModeState.SetMode(TransactionMode.Standard))" />
                <label class="form-check-label" for="flexcxModeStandard">
                    Standard &mdash; card selection from <code>PaymentCardSampleData</code>
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="flexcxTransactionMode" id="flexcxModeNetworkTokenTest"
                       checked="@(transactionModeState.Mode == TransactionMode.NetworkTokenTest)"
                       @onchange="@(() => OnSelectNetworkTokenTest())" />
                <label class="form-check-label" for="flexcxModeNetworkTokenTest">
                    Network Token Test &mdash; Network tokens ONLY, card selection from CyberSource's official <code>NetworkTokenTestCard</code> matrix.
                    No customer information needed &mdash; selecting this automatically creates the capture context.
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="flexcxTransactionMode" id="flexcxModePayerAuth"
                       checked="@(transactionModeState.Mode == TransactionMode.PayerAuthentication)"
                       @onchange="@(() => transactionModeState.SetMode(TransactionMode.PayerAuthentication))" />
                <label class="form-check-label" for="flexcxModePayerAuth">
                    Payer Authentication Test &mdash; card selection from the full 3DS 2.x test-case matrix
                </label>
            </div>
        </div>
    </div>
    @if (ntAutoStarted)
    {
        <div class="text-center py-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
            <p class="text-muted mt-2">Creating capture context for Network Token Test&hellip;</p>
        </div>
    }
    else
    {
        <CustomerMasterComponent ButtonText="Start Flex Checkout" FormElements="HomeFormElements" FormCustomer="b2CCustomer" ValidSubmit="SubmitCustomer"></CustomerMasterComponent>
    }
}

@* ── Stage: DeviceCollect (inline, hidden Cardinal iframe) ────────────────── *@
@if (stage == Stage.DeviceCollect)
{
    <div class="container">
        <div class="text-center py-4">
            <h4>Verifying device…</h4>
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
        <iframe id="flexcx-collection-iframe" name="flexcxCollectionIframe" height="10" width="10" style="display:none;" allow="payment"></iframe>
        <form id="flexcx-collection-form" method="POST" target="flexcxCollectionIframe" action="https://centinelapistag.cardinalcommerce.com/V1/Cruise/Collect">
            <input type="hidden" name="JWT" value="@paSetupAccessToken">
        </form>
    </div>
}

@* ── Stage: EnrollReview (inline) ─────────────────────────────────────────── *@
@if (stage == Stage.EnrollReview)
{
    <FormSection Title="3DS Enrollment Check" HelpText="">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-body">
                            <h5>Check Enrollment Request</h5>
                            @if (propertyValues.Count > 0)
                            {
                                <ul>
                                    @foreach (var propertyValue in propertyValues)
                                    {
                                        <li>@propertyValue</li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="card-footer">
                            @if (!enrollSubmitted)
                            {
                                <button class="btn btn-primary" type="button" @onclick="SubmitCheckEnrollment">
                                    Submit for Check Enrollment
                                </button>
                            }
                            else if (showAuthorizeButton)
                            {
                                <button class="btn btn-primary" type="button" @onclick="AuthorizeFrictionless">
                                    Authorize (Frictionless)
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </FormSection>
}

@* ── Stage: Result (inline) ───────────────────────────────────────────────── *@
@if (stage == Stage.Result)
{
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h4>@resultTitle</h4>
                @if (propertyValues.Count > 0)
                {
                    <ul>
                        @foreach (var propertyValue in propertyValues)
                        {
                            <li>@propertyValue</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" type="button" @onclick="ResetFlow">Start New Flex Checkout</button>
            </div>
        </div>
    </div>
}

@* ── Stage: Failed (inline) ───────────────────────────────────────────────── *@
@if (stage == Stage.Failed)
{
    <div class="row p-3">
        <strong class="alert-danger">@error</strong>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFlexCx" aria-controls="offcanvasFlexCx">
        Show Error Details
    </button>
    <ErorrDetails TransactionJson="_transactionJson"></ErorrDetails>
    <div class="mt-3">
        <button class="btn btn-secondary" type="button" @onclick="ResetFlow">Start New Flex Checkout</button>
    </div>
}

@* ── Modal: CardEntry (Flex Microform) ────────────────────────────────────── *@
@if (stage == Stage.CardEntry)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Card Details</h5>
                    <button type="button" class="btn-close" @onclick="ResetFlow"></button>
                </div>
                <div class="modal-body">
                    @if (!showTransToken)
                    {
                        <div id="flexcx-status" class="text-muted small mb-2">Initializing FlexMicroform...</div>
                        <div id="flexcx-errors-output" role="alert" class="mb-2"></div>
                        <div class="mb-2">
                            <button type="button" id="flexcx-retry-fields-btn" class="btn btn-sm btn-outline-secondary" onclick="flexcx_retryFlexFields()">
                                Reload Card Fields
                            </button>
                            <span class="text-muted small ms-2">CyberSource's sandbox occasionally fails to load a field — if one above looks broken, click to reload it.</span>
                        </div>
                        <div class="border-black">
                            @if (transactionModeState.Mode != TransactionMode.NetworkTokenTest)
                            {
                                <div class="mb-2">
                                    <label for="flexcx-cardholderName" class="form-label">Name</label>
                                    <input id="flexcx-cardholderName" class="form-control" value="@fullName" readonly>
                                </div>
                            }
                            @if (transactionModeState.Mode == TransactionMode.PayerAuthentication)
                            {
                                <label class="form-label">Payer Authentication Test Case</label>
                                <select class="form-select mb-2" @onchange="OnPaCardSelected">
                                    <option value="">-- Select a 3DS test case / card --</option>
                                    @foreach (var group in GroupedPaCards)
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var card in group)
                                            {
                                                <option value="@card.SamplePayAuthPaymentCardId">@card.OptionLabel</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                @if (selectedPaCard is not null)
                                {
                                    <div class="alert alert-info py-2 small mb-2">
                                        <div>Card Number (paste below): <code>@selectedPaCard.AccountNumber</code></div>
                                        <div>
                                            Expected: VeresEnrolled=<strong>@(selectedPaCard.VeresEnrolled ?? "N/A")</strong>,
                                            Step-Up=<strong>@(selectedPaCard.StepUpRequired ? "Yes" : "No")</strong>,
                                            PARes=<strong>@(selectedPaCard.ParesStatus ?? "N/A")</strong>,
                                            ECI=<strong>@(selectedPaCard.EciRawValue ?? "N/A")</strong>@(string.IsNullOrWhiteSpace(selectedPaCard.EciStringValue) ? "" : $" ({selectedPaCard.EciStringValue})")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(selectedPaCard.RequiresCountryOverride))
                                        {
                                            <div class="text-warning">Requires CountryCodeOverride=@selectedPaCard.RequiresCountryOverride &mdash; this merchant profile may not be configured for this region.</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(selectedPaCard.ExpectedOutcomeNotes))
                                        {
                                            <div class="text-muted">@selectedPaCard.ExpectedOutcomeNotes</div>
                                        }
                                    </div>
                                }
                            }
                            else if (transactionModeState.Mode == TransactionMode.NetworkTokenTest)
                            {
                                <label class="form-label">Network Token Test Card</label>
                                <select class="form-select mb-2" @onchange="OnNetworkTokenTestCardSelected">
                                    <option value="">-- Select a test card --</option>
                                    @foreach (var card in networkTokenTestCardService.Cards)
                                    {
                                        <option value="@card.NetworkTokenTestCardId">
                                            @(card.DisplayLabel ?? $"{card.CardBrand} — {card.AccountNumber} {card.ExpMonth}/{card.ExpYear}")
                                        </option>
                                    }
                                </select>
                                @if (selectedNetworkTokenTestCard is not null)
                                {
                                    <div class="alert alert-info py-2 small mb-2">
                                        Card Number (paste below): <code>@selectedNetworkTokenTestCard.AccountNumber</code>
                                    </div>
                                }
                            }
                            else
                            {
                                <label class="form-label">Standard Card</label>
                                <select class="form-select mb-2" @onchange="OnStandardCardSelected">
                                    <option value="">-- Select a test card --</option>
                                    @for (var i = 0; i < cardService.Cards.Count; i++)
                                    {
                                        var card = cardService.Cards[i];
                                        <option value="@i">@card.CardBrand @card.AccountNumber</option>
                                    }
                                </select>
                                @if (selectedStandardCard is not null)
                                {
                                    <div class="alert alert-info py-2 small mb-2">
                                        Card Number (paste below): <code>@selectedStandardCard.AccountNumber</code>
                                    </div>
                                }
                            }
                            <label id="flexcx-cardNumber-label" class="form-label">Card Number</label>
                            <div id="flexcx-number-field-status" class="text-muted small"></div>
                            <div id="flexcx-number-container" class="border border-1 rounded p-2 mb-2" style="width: 300px; height: 40px;"></div>
                            <label for="flexcx-securityCode-container" class="form-label">Security Code</label>
                            <div id="flexcx-securityCode-container" class="border border-1 rounded p-2 mb-2" style="background-color:white; width: 100px; height: 40px;"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label for="flexcx-expMonth" class="form-label">Expiry month</label>
                                    <select id="flexcx-expMonth" class="form-control" @bind="selectedExpMonth">
                                        <option>01</option><option>02</option><option>03</option><option>04</option>
                                        <option>05</option><option>06</option><option>07</option><option>08</option>
                                        <option>09</option><option>10</option><option>11</option><option>12</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="flexcx-expYear" class="form-label">Expiry year</label>
                                    <select id="flexcx-expYear" class="form-control" @bind="selectedExpYear">
                                        <option>2026</option><option>2027</option><option>2028</option><option>2029</option><option>2030</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (decodedTransientToken is not null)
                        {
                            <h6>Transient Token</h6>
                            <ul>
                                @foreach (var propertyValue in decodedTransientToken)
                                {
                                    <li>@propertyValue</li>
                                }
                            </ul>

                            <hr class="my-3">
                            <h6>Provision Network Token (Non-Payment)</h6>
                            <p class="text-muted small">
                                Independent of the payment flow below: uses this transient token to provision a
                                network token (<code>POST /tms/v2/tokenize</code>, then <code>GET /tms/v2/tokenized-cards/{id}</code>).
                                No payment is submitted.
                            </p>
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ProvisionNetworkToken" disabled="@ntProvisionBusy">
                                @(ntProvisionBusy ? "Provisioning…" : "Provision Network Token")
                            </button>

                            @if (ntProvisionError is not null)
                            {
                                <div class="alert alert-danger mt-2">@ntProvisionError</div>
                            }

                            @if (ntProvisionResult is not null)
                            {
                                <table class="table table-bordered table-sm mt-2">
                                    <tbody>
                                        <tr>
                                            <th scope="row">Network Token ID</th>
                                            <td>@(ntProvisionResult.Id ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">State</th>
                                            <td>@(ntProvisionResult.State ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Network Token Number</th>
                                            <td>@(ntProvisionResult.Number ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Expiration</th>
                                            <td>@(ntProvisionResult.ExpirationMonth ?? "—")/@(ntProvisionResult.ExpirationYear ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Card Type</th>
                                            <td>@(ntProvisionResult.Type ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Enrollment ID</th>
                                            <td>@(ntProvisionResult.EnrollmentId ?? "—")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        }
                        else
                        {
                            <p class="text-danger">@error</p>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (!showTransToken)
                    {
                        <button type="button" id="flexcx-pay-button" class="btn btn-primary">Create Transient Token</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" type="button" @onclick="SubmitTransTokenPaSetup">
                            Continue with 3DS (Recommended)
                        </button>
                        <button class="btn btn-outline-primary" type="button" @onclick="SubmitTransTokenPayment">
                            Authorize Now
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ── Modal: Challenge (3DS step-up) ───────────────────────────────────────── *@
@if (stage == Stage.Challenge)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Verify Your Identity</h5>
                </div>
                <div class="modal-body">
                    <iframe id="flexcx-step-up-iframe" name="flexcxStepUpIframe" height="390" width="100%" class="border" allow="payment"></iframe>
                    <form id="flexcx-step-up-form" target="flexcxStepUpIframe" method="post" action="@stepUpAuthUrl">
                        <input type="hidden" name="JWT" value="@stepUpJwt" />
                        <input type="hidden" name="MD" value="@stepUpMd" />
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="button" @onclick="ValidateOnly" disabled="@(!canManualContinue)">
                        Validate Only
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="ValidateAndAuthorize" disabled="@(!canManualContinue)">
                        Validate &amp; Authorize
                    </button>
                    <p class="text-muted small mb-0 mt-2 w-100">
                        Local testing: if the challenge completes but this modal does not advance
                        automatically (Chrome blocks the public-to-localhost callback), click one of
                        the buttons above — CyberSource already has the challenge result.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasFlexCx" aria-labelledby="offcanvasFlexCxLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasFlexCxLabel">Error Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <pre>@(_transactionJson is not null ? JsonLogFormatter.Pretty(_transactionJson) : error)</pre>
    </div>
</div>

<script src="https://testflex.cybersource.com/microform/bundle/v2/flex-microform.min.js" onload="flexcx_scriptLoadedHandler()"></script>

<script>

    window.flexcx_scriptLoaded = false;

    function flexcx_scriptLoadedHandler() {
        console.log("flexcx: flex-microform.min.js has loaded");
        window.flexcx_scriptLoaded = true;
    }

    window.flexcx_setDotNetReference = function (dotNetHelper) {
        window.flexcx_dotNetObjectReference = dotNetHelper;
        console.log("flexcx: dotNetObjectReference set.");
    };

    // Holds the currently-active Flex Microform instance so the Pay button
    // (bound once) always tokenizes against the latest fields, even after
    // flexcx_retryFlexFields() recreates them.
    window.flexcx_fields = { microform: null };

    function flexcx_initFlexFields() {
        var dotNetObjectReference = window.flexcx_currentDotNetRef;
        var jwt = window.flexcx_currentJwt;

        var statusDiv = document.getElementById('flexcx-status');
        var numberStatusDiv = document.getElementById('flexcx-number-field-status');
        var errorsOutput = document.querySelector('#flexcx-errors-output');
        var numberContainer = document.getElementById('flexcx-number-container');
        var securityCodeContainer = document.getElementById('flexcx-securityCode-container');

        errorsOutput.textContent = '';
        errorsOutput.className = '';
        statusDiv.textContent = 'Initializing FlexMicroform...';
        statusDiv.className = 'text-muted small mb-2';

        // Clear out any previously-inserted (possibly broken) field iframes first —
        // CyberSource's testflex sandbox occasionally returns an intermittent HTTP 520
        // for a field's nested iframe instead of the field rendering, with no JS error
        // we can reliably catch, so a manual reload is the fallback (see the button below).
        numberContainer.innerHTML = '';
        securityCodeContainer.innerHTML = '';

        var flex = new Flex(jwt);
        var microform = flex.microform('card');
        var number = microform.createField('number', { placeholder: 'Enter card number' });
        var securityCode = microform.createField('securityCode', { placeholder: '•••' });

        window.flexcx_fields.microform = microform;

        number.load('#flexcx-number-container');
        securityCode.load('#flexcx-securityCode-container');

        statusDiv.textContent = 'FlexMicroform ready — enter card details';
        statusDiv.className = 'text-success small mb-2';

        number.on('change', function (data) {
            dotNetObjectReference.invokeMethodAsync('LogFlexEvent', 'number:change', JSON.stringify(data));
            var msg = '';
            if (data.card && data.card.length > 0) {
                msg += 'Detected: ' + data.card.map(function (c) { return c.name; }).join('/');
            }
            if (data.valid !== undefined) {
                msg += (msg ? ' | ' : '') + (data.valid ? 'Valid' : 'Incomplete/Invalid');
            }
            if (data.empty) { msg = 'Enter card number'; }
            numberStatusDiv.textContent = msg;
            numberStatusDiv.className = data.valid ? 'text-success small' : 'text-warning small';
        });
    }

    window.flexcx_retryFlexFields = function () {
        console.log('flexcx: retrying FlexMicroform field load');
        flexcx_initFlexFields();
    };

    window.flexcx_executeFlexScript = function (dotNetObjectReference, jwt) {
        console.log("flexcx: inside flexcx_executeFlexScript");

        window.flexcx_currentDotNetRef = dotNetObjectReference;
        window.flexcx_currentJwt = jwt;

        var payButton = document.querySelector('#flexcx-pay-button');
        var errorsOutput = document.querySelector('#flexcx-errors-output');
        var statusDiv = document.getElementById('flexcx-status');

        flexcx_initFlexFields();

        payButton.addEventListener('click', function () {
            statusDiv.textContent = 'Tokenizing...';
            statusDiv.className = 'text-info small mb-2';
            errorsOutput.textContent = '';
            errorsOutput.className = '';

            var options = {
                expirationMonth: document.querySelector('#flexcx-expMonth').value,
                expirationYear: document.querySelector('#flexcx-expYear').value
            };

            window.flexcx_fields.microform.createToken(options, function (err, token) {
                if (err) {
                    console.error('flexcx: createToken error:', JSON.stringify(err));
                    dotNetObjectReference.invokeMethodAsync('LogFlexEvent', 'createToken:error', JSON.stringify(err));
                    var message;
                    if (Array.isArray(err)) {
                        message = err.map(function (e) {
                            return (e.location ? e.location + ': ' : '') + (e.message || JSON.stringify(e));
                        }).join('; ');
                    } else {
                        message = err.message || JSON.stringify(err);
                    }
                    errorsOutput.textContent = message;
                    errorsOutput.className = 'alert alert-danger';
                    statusDiv.textContent = 'Tokenization failed — see error above';
                    statusDiv.className = 'text-danger small mb-2';
                } else {
                    console.log("flexcx: Transient Token from Flex Script received");
                    dotNetObjectReference.invokeMethodAsync('ReceiveTransientToken', token);
                }
            });
        });
    };

    window.flexcx_submitCardinal = function () {
        var cardinalForm = document.getElementById('flexcx-collection-form');
        if (cardinalForm) {
            console.log('flexcx: Cardinal Form found — submitting form.');
            cardinalForm.submit();
        } else {
            console.log('flexcx: Cardinal Form NOT found — cannot submit.');
        }
    };

    window.addEventListener("message", function (event) {
        if (event.origin === "https://centinelapistag.cardinalcommerce.com") {
            console.log("flexcx: Received message from Cardinal DDC iframe");
            if (window.flexcx_dotNetObjectReference) {
                window.flexcx_dotNetObjectReference.invokeMethodAsync('ReceiveDataCollectionResponse', event.data);
            } else {
                console.error('flexcx: dotNetObjectReference is not set.');
            }
        }
    }, false);

    window.flexcx_collectBrowserDeviceInfo = function () {
        return {
            language: navigator.language || navigator.userLanguage || "",
            userAgent: navigator.userAgent || "",
            screenHeight: String(screen.height),
            screenWidth: String(screen.width),
            colorDepth: String(screen.colorDepth),
            timeDifference: String(new Date().getTimezoneOffset()),
            javaEnabled: String(navigator.javaEnabled ? navigator.javaEnabled() : false)
        };
    };

    window.flexcx_submitStepUp = function () {
        var stepUpForm = document.getElementById('flexcx-step-up-form');
        if (stepUpForm) {
            console.log('flexcx: step-up form found — submitting.');
            stepUpForm.submit();
        } else {
