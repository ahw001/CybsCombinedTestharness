    private async Task SubmitCheckEnrollment()
    {
        try
        {
            enrollSubmitted = true;

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(checkEnrollDto, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.PA_ENROLL);

            if (HasError(sessionResponse, out _))
            {
                Fail(sessionResponse?.error ?? "Check enrollment failed", sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse!);

            followOnTransResponse = JsonSerializer.Deserialize<FollowOnTransResponse>(sessionResponse!.TransactionJson!.ToString())!;
            propertyValues = PropertiesProcessor.GetProperties(followOnTransResponse!);

            authenticationTransactionId = followOnTransResponse.ConsumerAuthenticationInformation?.AuthenticationTransactionId;

            // Combined enroll+auth call (/pts/v2/payments with CONSUMER_AUTHENTICATION):
            // a challenge outcome arrives as CUSTOMER_AUTHENTICATION_REQUIRED and stops
            // before authorization; a frictionless outcome arrives already AUTHORIZED.
            if (followOnTransResponse.Status == "AUTHORIZED")
            {
                ShowResult(sessionResponse, "Frictionless Authorization Result");
            }
            else if (followOnTransResponse.Status == "CUSTOMER_AUTHENTICATION_REQUIRED"
                  || (followOnTransResponse.ConsumerAuthenticationInformation?.ParesStatus == "C"
                      && followOnTransResponse.ConsumerAuthenticationInformation?.VeresEnrolled == "Y"))
            {
                var caInfo = followOnTransResponse.ConsumerAuthenticationInformation!;
                stepUpAuthUrl = caInfo.StepUpUrl;
                stepUpJwt = caInfo.AccessToken;
                stepUpMd = Guid.NewGuid().ToString();

                stage = Stage.Challenge;
                _stepUpSubmitPending = true;
                StateHasChanged();
            }
            else if (followOnTransResponse.ConsumerAuthenticationInformation?.ParesStatus == "Y")
            {
                showAuthorizeButton = true;
                StateHasChanged();
            }
            else if (string.Equals(followOnTransResponse.ErrorInformation?.Reason, "PARTIAL_APPROVAL", StringComparison.OrdinalIgnoreCase))
            {
                // CyberSource sandbox behavior for certain total amounts (observed at $3602.00):
                // the combined enroll+auth call returns HTTP 202 with a numeric "status" and
                // errorInformation.reason = PARTIAL_APPROVAL instead of the payments-API
                // PARTIAL_AUTHORIZED status CallMinAPIs otherwise detects. This is a legitimate
                // outcome (per AppErrorConfig's PARTIAL_AUTHORIZED exclusion), not a failure.
                ShowResult(sessionResponse, "Partial Approval Result");
            }
            else
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Fail("Error: " + ex.Message);
        }
    }

    private async Task AuthorizeFrictionless()
    {
        try
        {
            var aftValidateDto = BuildAftValidateDto(includeAftIndicator: true);
            aftValidateDto.ConsumerAuthenticationInformation!.AuthenticationTransactionId = authenticationTransactionId;
            aftValidateDto.ProcessingInformation!.ActionList = new string[] { "VALIDATE_CONSUMER_AUTHENTICATION", "TOKEN_CREATE" };
            aftValidateDto.ProcessingInformation.ActionTokenTypes = new string[] { "paymentInstrument, instrumentIdentifier" };

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(aftValidateDto, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.FLEX_AFT_VALIDATE_AUTH);

            if (HasError(sessionResponse, out _))
            {
                Fail(sessionResponse?.error ?? "Frictionless authorization failed", sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse!);
            ShowResult(sessionResponse!, "Frictionless Authorization Result");
        }
        catch (Exception ex)
        {
            Fail("Error: " + ex.Message);
        }
