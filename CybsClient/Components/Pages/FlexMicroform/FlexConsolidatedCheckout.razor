                await Task.Delay(100);
            }
            await JSRuntime.InvokeVoidAsync("flexcx_executeFlexScript", _dotNetRef, jwt);
        }

        if (_cardinalSubmitPending)
        {
            _cardinalSubmitPending = false;
            await Task.Delay(150);
            await JSRuntime.InvokeVoidAsync("flexcx_submitCardinal");
        }

        if (_stepUpSubmitPending)
        {
            _stepUpSubmitPending = false;
            await Task.Delay(300);
            await JSRuntime.InvokeVoidAsync("flexcx_submitStepUp");
        }
