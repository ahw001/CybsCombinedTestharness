        }

        if (_cardScriptInitPending)
        {
            _cardScriptInitPending = false;

            var deadline = DateTime.UtcNow.AddSeconds(10);
            while (!await JSRuntime.InvokeAsync<bool>("eval", "window.flexcx_scriptLoaded === true"))
            {
                if (DateTime.UtcNow > deadline)
                {
                    Console.WriteLine("flexcx: FlexMicroform script load timed out after 10 seconds.");
                    Fail("FlexMicroform failed to load. Check your network connection and that testflex.cybersource.com is reachable.");
                    return;
