    private async Task ValidateOnly()
    {
        try
        {
            var aftValidateDto = new AftValidateDto
            {
                ConsumerAuthenticationInformation = new ConsumerAuthenticationInformation
                {
                    AuthenticationTransactionId = authenticationTransactionId
                },
                PaymentInformation = new PaymentInformation
                {
                    Card = new FullCard { Type = "001" }
                }
            };

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(aftValidateDto, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.PA_VALIDATE);

            if (HasError(sessionResponse, out _))
            {
                Fail(sessionResponse?.error ?? "Validation failed", sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse!);
            ShowResult(sessionResponse!, "Validation Result");
        }
        catch (Exception ex)
        {
            Fail("Error: " + ex.Message);
        }
    }

    private async Task ValidateAndAuthorize()
    {
        try
        {
            var aftValidateDto = BuildAftValidateDto(includeAftIndicator: true);
            aftValidateDto.ConsumerAuthenticationInformation!.AuthenticationTransactionId = authenticationTransactionId;
            aftValidateDto.ProcessingInformation!.ActionList = new string[] { "VALIDATE_CONSUMER_AUTHENTICATION", "TOKEN_CREATE" };
            aftValidateDto.ProcessingInformation.ActionTokenTypes = new string[] { "paymentInstrument, instrumentIdentifier" };
            aftValidateDto.TokenInformation!.TransientTokenJwt = b2CCustomer.TransientTokenJwt ?? transientCtxToken;

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(aftValidateDto, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.FLEX_AFT_VALIDATE_AUTH);

            if (HasError(sessionResponse, out _))
            {
                Fail(sessionResponse?.error ?? "Validation and authorization failed", sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse!);
            ShowResult(sessionResponse!, "Validation & Authorization Result");
        }
        catch (Exception ex)
        {
            Fail("Error: " + ex.Message);
        }
    }

    private AftValidateDto BuildAftValidateDto(bool includeAftIndicator)
    {
        return new AftValidateDto
        {
            ClientReferenceInformation = new ClientReferenceInformation
            {
                Code = "PA" + DateTime.UtcNow.ToString("yyyyMMddHHmmss")
            },
            ProcessingInformation = new ProcessingInformation
            {
                AuthorizationOptions = new AuthorizationOptions
                {
                    AftIndicator = includeAftIndicator ? true : null,
                    PartialAuthIndicator = b2CCustomer.AllowPartialAuth ? true : null
                },
                CommerceIndicator = "internet",
                BusinessApplicationId = "AA",
                PurposeOfPayment = "ISACCT"
            },
            OrderInformation = new OrderInformation
            {
                AmountDetails = new AmountDetails
                {
                    TotalAmount = b2CCustomer.TotalAmount.HasValue ? b2CCustomer.TotalAmount.Value.ToString("0.00") : "0.00",
                    Currency = b2CCustomer.Currency ?? "USD"
                },
                BillTo = new BillTo
                {
                    FirstName = b2CCustomer.FirstName ?? "null",
                    LastName = b2CCustomer.LastName ?? "null",
                    Address1 = b2CCustomer.Address1 ?? "null",
                    Locality = b2CCustomer.City ?? "null",
                    AdministrativeArea = b2CCustomer.AdministrativeArea ?? "null",
                    PostalCode = b2CCustomer.PostalCode ?? "null",
                    Country = b2CCustomer.Country ?? "null",
                    PhoneNumber = b2CCustomer.Phone ?? "null",
                    Email = b2CCustomer.Email ?? "null"
                }
            },
            TokenInformation = new TokenInformation
            {
                TransientTokenJwt = b2CCustomer.TransientTokenJwt ?? transientCtxToken
            },
            ConsumerAuthenticationInformation = new ConsumerAuthenticationInformation()
        };
    }

    // ── Stage 6: Result / Failure ─────────────────────────────────────────────

    private void ShowResult(SessionTransJson sessionResponse, string title)
    {
        resultTitle = title;

        if (sessionResponse.TransactionJson is not null)
        {
            followOnTransResponse = JsonSerializer.Deserialize<FollowOnTransResponse>(sessionResponse.TransactionJson.ToString())!;
            propertyValues = PropertiesProcessor.GetProperties(followOnTransResponse!);
        }

        stage = Stage.Result;
        StateHasChanged();
    }

    private void ResetFlow()
    {
        sessionTransactions.DeleteAll();
        customersScoped.DeleteAll();
        ctxContext.DeleteCtx();
        diTransientToken.DeleteTt();

        stage = Stage.CustomerEntry;
        b2CCustomer = new();
        sessionTransJson = new();
        captureContextDto = new();
        checkEnrollDto = new();
        followOnTransResponse = new();

        jwt = null;
        transientToken = null;
        transientCtxToken = null;
        fullName = null;
        error = null;
        paSetupAccessToken = null;
        authenticationTransactionId = null;
        stepUpAuthUrl = null;
        stepUpJwt = null;
        stepUpMd = null;
        resultTitle = string.Empty;

        showTransToken = false;
        enrollSubmitted = false;
        showAuthorizeButton = false;
        decodedTransientToken = null;
        propertyValues = new();
        _transactionJson = null;

        ntProvisionError = null;
        ntProvisionResult = null;

        selectedPaCard = null;
        selectedStandardCard = null;
        selectedNetworkTokenTestCard = null;
        selectedExpMonth = "12";
        selectedExpYear = "2027";

        ntAutoStarted = false;
        StateHasChanged();
    }

    private bool HasError(SessionTransJson? sessionResponse, out List<BasicErrorInfo> foundErrors)
    {
        foundErrors = new List<BasicErrorInfo>();

        if (sessionResponse is null || sessionResponse.TransactionStatus == "error")
        {
            return true;
        }

        if (sessionResponse.TransactionJson is not null)
        {
            foundErrors = JsonErrorExtractor.ExtractErrorObjects(sessionResponse.TransactionJson.ToString());

            bool containsError = foundErrors.Any(e =>
                AppErrorConfig.ErrorKeywords.Any(k =>
                    $"{e.Status} {e.Reason} {e.Message} {e.Action}"
                        .ToLowerInvariant()
                        .Contains(k.ToLowerInvariant())
                )
            );

            if (containsError)
            {
                return true;
            }
        }

        return false;
    }

    private void Fail(string message, SessionTransJson? response = null)
    {
        error = message;
        _transactionJson = response?.TransactionJson;

        var errorResponse = response ?? new SessionTransJson();
        errorResponse.error = message;
        errorResponse.TransactionStatus = "error";
        sessionTransactions.AddTrans(errorResponse);

        stage = Stage.Failed;
        StateHasChanged();
    }

