@page "/flexform"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IJSRuntime JSRuntime
@inject ICustomersScoped custTransFormDto
@inject NavigationManager Navigation
@inject ICustomersScoped customersScoped
@inject ICtxContext ctxContext
@inject ITransientToken diTransientToken
@inject ITransactionModeState transactionModeState
@inject ICardService cardService
@inject IPayerAuthTestCardService payerAuthTestCardService
@inject INetworkTokenTestCardService networkTokenTestCardService


@inject ISessionTransactions sessionTransactions

<PageTitle>Flex Checkout Form</PageTitle>

<hr class="my-4">
@if (showInitialForm)
{
    <h1>Flex Form for PAN Entry</h1>
    <div id="flex-status" class="text-muted small mb-2">Initializing FlexMicroform...</div>
    <div id="errors-output" role="alert" class="mb-2"></div>
    <div class="mb-2">
        <button type="button" id="retry-fields-btn" class="btn btn-sm btn-outline-secondary" onclick="retryFlexFields()">
            Reload Card Fields
        </button>
        <span class="text-muted small ms-2">CyberSource's sandbox occasionally fails to load a field — if one above looks broken, click to reload it.</span>
    </div>
    <div class="col-6 border-black">
        <form action="/token" id="my-sample-form" method="post">
            <div class="form-group border-1">
                @if (transactionModeState.Mode != TransactionMode.NetworkTokenTest)
                {
                    <label for="cardholderName">Name</label>
                    <input id="cardholderName" class="form-control" @bind="fullName" placeholder="Name on the card">
                }

                @if (transactionModeState.Mode == TransactionMode.PayerAuthentication)
                {
                    <label class="form-label">Payer Authentication Test Case</label>
                    <select class="form-select mb-2" @onchange="OnPaCardSelected">
                        <option value="">-- Select a 3DS test case / card --</option>
                        @foreach (var group in GroupedPaCards)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var card in group)
                                {
                                    <option value="@card.SamplePayAuthPaymentCardId">@card.OptionLabel</option>
                                }
                            </optgroup>
                        }
                    </select>
                    @if (selectedPaCard is not null)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            <div>Card Number (paste below): <code>@selectedPaCard.AccountNumber</code></div>
                            <div>
                                Expected: VeresEnrolled=<strong>@(selectedPaCard.VeresEnrolled ?? "N/A")</strong>,
                                Step-Up=<strong>@(selectedPaCard.StepUpRequired ? "Yes" : "No")</strong>,
                                PARes=<strong>@(selectedPaCard.ParesStatus ?? "N/A")</strong>,
                                ECI=<strong>@(selectedPaCard.EciRawValue ?? "N/A")</strong>@(string.IsNullOrWhiteSpace(selectedPaCard.EciStringValue) ? "" : $" ({selectedPaCard.EciStringValue})")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(selectedPaCard.RequiresCountryOverride))
                            {
                                <div class="text-warning">Requires CountryCodeOverride=@selectedPaCard.RequiresCountryOverride &mdash; this merchant profile may not be configured for this region.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedPaCard.ExpectedOutcomeNotes))
                            {
                                <div class="text-muted">@selectedPaCard.ExpectedOutcomeNotes</div>
                            }
                        </div>
                    }
                }
                else if (transactionModeState.Mode == TransactionMode.NetworkTokenTest)
                {
                    <label class="form-label">Network Token Test Card</label>
                    <select class="form-select mb-2" @onchange="OnNetworkTokenTestCardSelected">
                        <option value="">-- Select a test card --</option>
                        @foreach (var card in networkTokenTestCardService.Cards)
                        {
                            <option value="@card.NetworkTokenTestCardId">
                                @(card.DisplayLabel ?? $"{card.CardBrand} — {card.AccountNumber} {card.ExpMonth}/{card.ExpYear}")
                            </option>
                        }
                    </select>
                    @if (selectedNetworkTokenTestCard is not null)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            Card Number (paste below): <code>@selectedNetworkTokenTestCard.AccountNumber</code>
                        </div>
                    }
                }
                else
                {
                    <label class="form-label">Standard Card</label>
                    <select class="form-select mb-2" @onchange="OnStandardCardSelected">
                        <option value="">-- Select a test card --</option>
                        @for (var i = 0; i < cardService.Cards.Count; i++)
                        {
                            var card = cardService.Cards[i];
                            <option value="@i">@card.CardBrand @card.AccountNumber</option>
                        }
                    </select>
                    @if (selectedStandardCard is not null)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            Card Number (paste below): <code>@selectedStandardCard.AccountNumber</code>
                        </div>
                    }
                }
                <label id="cardNumber-label">Card Number</label>
                <div id="number-field-status" class="text-muted small"></div>
                <div id="number-container" class="border border-1 rounded p-2" style="width: 300px; height: 40px;"></div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="expMonth">Expiry month</label>
                    <select id="expMonth" class="form-control" @bind="selectedExpMonth">
                        <option>01</option>
                        <option>02</option>
                        <option>03</option>
                        <option>04</option>
                        <option>05</option>
                        <option>06</option>
                        <option>07</option>
                        <option>08</option>
                        <option>09</option>
                        <option>10</option>
                        <option>11</option>
                        <option>12</option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label for="expYear">Expiry year</label>
                    <select id="expYear" class="form-control" @bind="selectedExpYear">
                        <option>2026</option>
                        <option>2027</option>
                        <option>2028</option>
                        <option>2029</option>
                        <option>2030</option>
                    </select>
                </div>
            </div>

            <div class="form-group border-1">
                <label for="securityCode-container">Security Code</label>
                <div id="securityCode-container" class="border border-1 rounded p-2" style="background-color:white; width: 100px; height: 40px;"></div>
            </div>

            <button type="button" id="pay-button" class="btn btn-primary">Pay</button>
            <input type="hidden" id="flexresponse" name="flexresponse">
        </form>
    </div>
}

@if (showTransToken)
{
    <div class="container">
        <div class="row row-cols-1 row-cols-md-2 gy-4">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        @if (decodedTransientToken is not null)
                        {
                            <h4>Transient Token</h4>
                            @foreach (var propertyValue in decodedTransientToken)
                            {
                                <span>@propertyValue</span>
                            }
                            <hr class="my-4">
                            <button class="btn btn-primary" type="button" @onclick="SubmitTransTokenPayment">
                                SUBMIT FOR AUTHORIZATION
                            </button>
                            <hr class="my-4">
                            <button class="btn btn-primary" type="button" @onclick="SubmitAftTransToken">
                                SUBMIT FOR AFT
                            </button>
                            <hr class="my-4">
                            <button class="btn btn-primary" type="button" @onclick="SubmitTransTokenPaSetup">
                                SUBMIT FOR PA SETUP
                            </button>

                            <hr class="my-4">
                            <h5>Provision Network Token (Non-Payment)</h5>
                            <p class="text-muted small">
                                Independent of the checkout above: uses this transient token to provision a network token
                                (<code>POST /tms/v2/tokenize</code>, then <code>GET /tms/v2/tokenized-cards/{id}</code>).
                                No payment is submitted.
                            </p>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ProvisionNetworkToken" disabled="@ntProvisionBusy">
                                @(ntProvisionBusy ? "Provisioning…" : "Provision Network Token")
                            </button>

                            @if (ntProvisionError is not null)
                            {
                                <div class="alert alert-danger mt-2">@ntProvisionError</div>
                            }

                            @if (ntProvisionResult is not null)
                            {
                                <table class="table table-bordered table-sm mt-2">
                                    <tbody>
                                        <tr>
                                            <th scope="row">Network Token ID</th>
                                            <td>@(ntProvisionResult.Id ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">State</th>
                                            <td>@(ntProvisionResult.State ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Network Token Number</th>
                                            <td>@(ntProvisionResult.Number ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Expiration</th>
                                            <td>@(ntProvisionResult.ExpirationMonth ?? "—")/@(ntProvisionResult.ExpirationYear ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Card Type</th>
                                            <td>@(ntProvisionResult.Type ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Enrollment ID</th>
                                            <td>@(ntProvisionResult.EnrollmentId ?? "—")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        }
                        else
                        {
                            <h4>Error</h4>
                            <p>@error</p>
                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Follow on Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="void">New Flex Checkout</a></li>
                                    <li><a class="dropdown-item" href="/">Home</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
            @if (decodedTransientToken is not null)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h4>Raw Transient Token JWT</h4>
                            <p class="text-muted small">
                                Copy this for use with CyberSource's direct API reference website.
                            </p>
                            <textarea class="form-control mb-2" rows="10" readonly>@transientCtxToken</textarea>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CopyToClipboard">
                                <i class="bi bi-clipboard me-1"></i> Copy
                            </button>
                            @if (copiedMessage is not null)
                            {
                                <small class="text-success ms-2">@copiedMessage</small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<hr class="my-4">

<input type="hidden" id="jwt" @bind="jwt" />
<input type="hidden" id="transientToken" />

<script src="https://testflex.cybersource.com/microform/bundle/v2/flex-microform.min.js" onload="scriptLoaded()"></script>

<script>

    window.scriptIsLoaded = false;

    function syncCardholderName(dotNetObjectReference) {
        // The Name field is not rendered in Network Token Test mode (no cardholder name needed).
        var nameField = document.getElementById('cardholderName');
        var nameValue = nameField ? nameField.value : '';
        dotNetObjectReference.invokeMethodAsync('UpdateFullNameFromJs', nameValue);
    }

    function scriptLoaded() {
        console.log("flex-microform.min.js has loaded");
        window.scriptIsLoaded = true;
    }

    // Holds the currently-active Flex Microform instance so the Pay button
    // (bound once) always tokenizes against the latest fields, even after
    // retryFlexFields() recreates them.
    window.flexform_fields = { microform: null };

    function initFlexFields() {
        var dotNetObjectReference = window.flexform_currentDotNetRef;
        var jwt = window.flexform_currentJwt;

        var statusDiv = document.getElementById('flex-status');
        var numberStatusDiv = document.getElementById('number-field-status');
        var errorsOutput = document.querySelector('#errors-output');
        var numberContainer = document.getElementById('number-container');
        var securityCodeContainer = document.getElementById('securityCode-container');

        errorsOutput.textContent = '';
        errorsOutput.className = '';
        statusDiv.textContent = 'Initializing FlexMicroform...';
        statusDiv.className = 'text-muted small mb-2';

        // Clear out any previously-inserted (possibly broken) field iframes first —
        // CyberSource's testflex sandbox occasionally returns an intermittent HTTP 520
        // for a field's nested iframe instead of the field rendering, with no JS error
        // we can reliably catch, so a manual reload is the fallback (see the button below).
        numberContainer.innerHTML = '';
        securityCodeContainer.innerHTML = '';

        var flex = new Flex(jwt);
        var microform = flex.microform('card');
        var number = microform.createField('number', { placeholder: 'Enter card number' });
        var securityCode = microform.createField('securityCode', { placeholder: '•••' });

        window.flexform_fields.microform = microform;

        number.load('#number-container');
        securityCode.load('#securityCode-container');

        statusDiv.textContent = 'FlexMicroform ready — enter card details';
        statusDiv.className = 'text-success small mb-2';

        number.on('change', function (data) {
            console.log('FlexMicroform number:change', JSON.stringify(data));
            dotNetObjectReference.invokeMethodAsync('LogFlexEvent', 'number:change', JSON.stringify(data));
            var msg = '';
            if (data.card && data.card.length > 0) {
                msg += 'Detected: ' + data.card.map(function (c) { return c.name; }).join('/');
            }
            if (data.valid !== undefined) {
                msg += (msg ? ' | ' : '') + (data.valid ? 'Valid' : 'Incomplete/Invalid');
            }
            if (data.empty) { msg = 'Enter card number'; }
            numberStatusDiv.textContent = msg;
            numberStatusDiv.className = data.valid ? 'text-success small' : 'text-warning small';
        });
    }

    function retryFlexFields() {
        console.log('Retrying FlexMicroform field load');
        initFlexFields();
    }

    function executeFlexScript(dotNetObjectReference, jwt) {
        console.log("....inside executeFlexScript....");

        syncCardholderName(dotNetObjectReference);

        window.flexform_currentDotNetRef = dotNetObjectReference;
        window.flexform_currentJwt = jwt;

        var payButton = document.querySelector('#pay-button');
        var flexResponse = document.querySelector('#flexresponse');
        var errorsOutput = document.querySelector('#errors-output');
        var statusDiv = document.getElementById('flex-status');

        initFlexFields();

        payButton.addEventListener('click', function () {
            console.log('Pay button clicked — calling createToken');
            statusDiv.textContent = 'Tokenizing...';
            statusDiv.className = 'text-info small mb-2';
            errorsOutput.textContent = '';
            errorsOutput.className = '';

            var options = {
                expirationMonth: document.querySelector('#expMonth').value,
                expirationYear: document.querySelector('#expYear').value
            };

            window.flexform_fields.microform.createToken(options, function (err, token) {
                if (err) {
                    console.error('createToken error:', JSON.stringify(err));
                    dotNetObjectReference.invokeMethodAsync('LogFlexEvent', 'createToken:error', JSON.stringify(err));
                    var message;
                    if (Array.isArray(err)) {
                        message = err.map(function (e) {
                            return (e.location ? e.location + ': ' : '') + (e.message || JSON.stringify(e));
                        }).join('; ');
                    } else if (Array.isArray(err.details) && err.details.length > 0) {
                        message = err.details.map(function (e) {
                            return (e.location ? e.location + ': ' : '') + (e.message || JSON.stringify(e));
                        }).join('; ');
                    } else {
                        message = err.message || JSON.stringify(err);
                    }
                    errorsOutput.textContent = message;
                    errorsOutput.className = 'alert alert-danger';
                    statusDiv.textContent = 'Tokenization failed — see error above';
                    statusDiv.className = 'text-danger small mb-2';
                } else {
                    console.log("Transient Token from Flex Script:", JSON.stringify(token));
                    flexResponse.value = JSON.stringify(token);
                    dotNetObjectReference.invokeMethodAsync('ReceiveTransientToken', token);
                }
            });
        });
    }
</script>



@code {


    private string? jwt;
    private string? error = null;
    private string? transientCtxToken;
    private string? transientToken = string.Empty;
    private string? fullName = string.Empty;

    private List<string> propertyValues = new List<string>();
    private FollowOnTransResponse? followOnTransResponse = new FollowOnTransResponse();
    private static List<BasicErrorInfo> basicErrorInfos = new List<BasicErrorInfo>();

    public Dictionary<string, string>? decodedTransientToken { get; private set; }

    private AftRequestDto aftRequestDto = new AftRequestDto();

    private DotNetObjectReference<FlexForm>? _dotNetRef;

    private ISessionTransactions _sessionTransactions = new SessionTransactions();
    private SessionTransJson sessionTransJson = new SessionTransJson();
    private B2cCustomer b2CCustomer = new B2cCustomer();
    private CaptureContextDto captureContextDto = new CaptureContextDto();

    private CcTransactionTypes currentTransaction;

    private bool showInitialForm = true;
    private bool showTransToken = false;

    private JsonNode? _transactionJson = null;

    // ── Raw transient token copy (for pasting into CyberSource's direct API reference) ──
    private string? copiedMessage;

    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrWhiteSpace(transientCtxToken))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", transientCtxToken);
            copiedMessage = "Copied to clipboard!";
            StateHasChanged();
        }
    }

    // ── Provision Network Token (non-payment) state ──────────────────────────
    private bool ntProvisionBusy;
    private string? ntProvisionError;
    private NetworkTokenProvisionResultDto? ntProvisionResult;

    private async Task ProvisionNetworkToken()
    {
        if (string.IsNullOrWhiteSpace(transientCtxToken))
        {
            return;
        }

        ntProvisionError = null;
        ntProvisionResult = null;
        ntProvisionBusy = true;

        try
        {
            var result = await CallMinAPIs.ProvisionNetworkTokenAsync(transientCtxToken);
            if (result.Error is not null)
            {
                ntProvisionError = $"{result.Error.Error}: {result.Error.Message}";
            }
            else
            {
                ntProvisionResult = result.Data;
            }
        }
        catch (Exception ex)
        {
            ntProvisionError = "Error: " + ex.Message;
        }
        finally
        {
            ntProvisionBusy = false;
        }
    }

    // ── Test-card dropdown state ─────────────────────────────────────────────
    private PayerAuthTestCardDto? selectedPaCard;
    private PayerAuthCardSampleDto? selectedStandardCard;
    private NetworkTokenTestCardDto? selectedNetworkTokenTestCard;
    private string selectedExpMonth = "12";
    private string selectedExpYear = "2027";

    private IEnumerable<IGrouping<string, PayerAuthTestCardDto>> GroupedPaCards =>
        payerAuthTestCardService.Cards
            .OrderBy(c => c.TestCaseId, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.CardBrand)
            .GroupBy(c => c.TestCaseGroupLabel);

    private void OnPaCardSelected(ChangeEventArgs e)
    {
        selectedPaCard = int.TryParse(e.Value?.ToString(), out var id)
            ? payerAuthTestCardService.Cards.FirstOrDefault(c => c.SamplePayAuthPaymentCardId == id)
            : null;

        if (selectedPaCard is not null)
        {
            selectedExpMonth = selectedPaCard.ExpMonth ?? selectedExpMonth;
            selectedExpYear = selectedPaCard.ExpYear ?? selectedExpYear;
        }
    }

    private void OnStandardCardSelected(ChangeEventArgs e)
    {
        // Indexes into cardService.Cards, not SamplePayAuthPaymentCardId: that field is always 0
        // when this list is populated from PaymentCardSampleData (its real PK is SamplePaymentCardId,
        // a JSON-property-name mismatch pre-existing in PayerAuthCardSampleDto/CardService).
        selectedStandardCard = int.TryParse(e.Value?.ToString(), out var index) && index >= 0 && index < cardService.Cards.Count
            ? cardService.Cards[index]
            : null;

        if (selectedStandardCard is not null)
        {
            selectedExpMonth = selectedStandardCard.ExpMonth ?? selectedExpMonth;
            selectedExpYear = selectedStandardCard.ExpYear ?? selectedExpYear;
        }
    }

    private void OnNetworkTokenTestCardSelected(ChangeEventArgs e)
    {
        selectedNetworkTokenTestCard = int.TryParse(e.Value?.ToString(), out var id)
            ? networkTokenTestCardService.Cards.FirstOrDefault(c => c.NetworkTokenTestCardId == id)
            : null;

        if (selectedNetworkTokenTestCard is not null)
        {
            selectedExpMonth = selectedNetworkTokenTestCard.ExpMonth ?? selectedExpMonth;
            selectedExpYear = selectedNetworkTokenTestCard.ExpYear ?? selectedExpYear;
        }
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override void OnParametersSet()
    {
        StateHasChanged();
        base.OnParametersSet();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _sessionTransactions = sessionTransactions;

            if (_sessionTransactions.Transactions.Any())
            {
                sessionTransJson = _sessionTransactions.Transactions!.LastOrDefault()!;

                captureContextDto = JsonSerializer.Deserialize<CaptureContextDto>(sessionTransJson.TransactionJson)!;

                jwt = captureContextDto.Ctx;

                b2CCustomer = sessionTransJson?.Customer!;
                if (b2CCustomer.FirstName is not null && b2CCustomer.LastName is not null)
                {
                    fullName = b2CCustomer.FirstName + " " + b2CCustomer.LastName;
                }

                StateHasChanged();
            }
            else
            {
                error = "No Data";
                showInitialForm = false;
                showTransToken = true;
            }

            var deadline = DateTime.UtcNow.AddSeconds(10);
            while (!await JSRuntime.InvokeAsync<bool>("eval", "window.scriptIsLoaded"))
            {
                if (DateTime.UtcNow > deadline)
                {
                    Console.WriteLine("FlexMicroform script load timed out after 10 seconds.");
                    error = "FlexMicroform failed to load. Check your network connection and that testflex.cybersource.com is reachable.";
                    showInitialForm = false;
                    showTransToken = true;
                    StateHasChanged();
                    return;
                }
                await Task.Delay(100);
            }

            if (string.IsNullOrWhiteSpace(jwt))
            {
                error = "Failed to load payment form: capture context was not available. Please refresh the page.";
                showInitialForm = false;
                showTransToken = true;
                StateHasChanged();
                return;
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("executeFlexScript", _dotNetRef, jwt);
            }
            catch (JSException ex)
            {
                Console.WriteLine($"FlexMicroform JS error: {ex.Message}");
                error = "Payment form failed to initialize. Please refresh the page.";
                showInitialForm = false;
                showTransToken = true;
                StateHasChanged();
            }


        }
    }

    [JSInvokable]
    public void ReceiveTransientToken(string tt)
    {
        Console.WriteLine($"Transient Token received: {tt}");
        // Handle the token as needed
        if (tt != null)
        {
            sessionTransactions.DeleteAll();

            ctxContext.DeleteCtx();
            ctxContext.SetCtx(tt);

            decodedTransientToken = JWTItems.DecodeJWT(tt);

            copiedMessage = null;
            transientCtxToken = tt;
            sessionTransJson.TransientToken = transientCtxToken;

            sessionTransactions.AddTrans(sessionTransJson);

            foreach (var kvp in decodedTransientToken)
            {
                Console.WriteLine($"Decoded Transient Token Key: {kvp.Key}, Value: {kvp.Value}");
                const string V = "jti";
                if (kvp.Key == V)
                {
                    transientToken = kvp.Value;
                    diTransientToken.DeleteTt();
                    diTransientToken.SetTt(transientToken);
                }
            }

            // Session TransientToken must hold the jti (what /risk/v1/authentications
            // accepts in tokenInformation.transientToken), not the full JWT.
            if (transientToken is not null)
            {
                sessionTransJson.TransientToken = transientToken;
            }

            if (transientCtxToken is not null && customersScoped.CustData.Any() && customersScoped.CustData.LastOrDefault() is not null)
            {
                customersScoped.CustData.LastOrDefault()!.TransientTokenJwt = transientCtxToken;
            }

            if (transientToken is not null && customersScoped.CustData.Any() && customersScoped.CustData.LastOrDefault() is not null)
            {
                customersScoped.CustData.LastOrDefault()!.TransientToken = transientToken;    
            }

            showTransToken = true;
            showInitialForm = false;
        }
        else
        {
            error = "No Transient Token received";
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void LogFlexEvent(string eventName, string data)
    {
        Console.WriteLine($"FlexMicroform [{eventName}]: {data}");
    }

    [JSInvokable]
    public void UpdateFullNameFromJs(string nameValue)
    {
        fullName = nameValue;
        StateHasChanged();
    }


    public async void SubmitTransTokenPayment()
    {
        string response = string.Empty;

        CtxPaymentDto ctxPaymentDto = new();

        Guid guid = Guid.NewGuid();

        ctxPaymentDto.TokenInformation!.TransientTokenJwt = transientCtxToken;
        ctxPaymentDto.ClientReferenceInformation!.Code = guid.ToString();
        ctxPaymentDto.OrderInformation!.AmountDetails!.AuthorizedAmount = b2CCustomer.TotalAmount.HasValue ? b2CCustomer.TotalAmount.Value.ToString("0.00") : "0.00"; 
        ctxPaymentDto.OrderInformation!.AmountDetails.TotalAmount = b2CCustomer.TotalAmount.HasValue ? b2CCustomer.TotalAmount.Value.ToString("0.00") : "0.00";
        ctxPaymentDto.OrderInformation!.AmountDetails.Currency = b2CCustomer.Currency;
        ctxPaymentDto.B2cCustomerId = captureContextDto.B2cCustomerId;
        ctxPaymentDto.OrderId = captureContextDto.OrderId;
        ctxPaymentDto.OrderInformation.BillTo!.FirstName = b2CCustomer.FirstName;
        ctxPaymentDto.OrderInformation.BillTo!.LastName = b2CCustomer.LastName;
        ctxPaymentDto.OrderInformation.BillTo!.Email = b2CCustomer.Email;
        ctxPaymentDto.OrderInformation.BillTo!.PhoneNumber = b2CCustomer.Phone;
        ctxPaymentDto.OrderInformation.BillTo!.Address1 = b2CCustomer.Address1;
        ctxPaymentDto.OrderInformation.BillTo!.Locality = b2CCustomer.City;
        ctxPaymentDto.OrderInformation.BillTo!.AdministrativeArea = b2CCustomer.AdministrativeArea;
        ctxPaymentDto.OrderInformation.BillTo!.PostalCode = b2CCustomer.PostalCode;
        ctxPaymentDto.OrderInformation.BillTo!.Country = b2CCustomer.Country;

        if (b2CCustomer.AllowPartialAuth)
        {
            ctxPaymentDto.ProcessingInformation!.AuthorizationOptions = new AuthorizationOptions { PartialAuthIndicator = true };
        }

        sessionTransJson = new();

        sessionTransJson.CurrentTransactionType = CcTransactionTypes.FLEX_CHECKOUT_PAYMENT;
        currentTransaction = CcTransactionTypes.FLEX_CHECKOUT_PAYMENT;

        // Serialize the object into a string for submission

        var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
        string jsonString = JsonSerializer.Serialize(ctxPaymentDto, options);

        try
        {
            // POST FOR FLEX CHECKOUT PAYMENT TRANSACTION *******

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                _sessionTransactions, (CcTransactionTypes)sessionTransJson.CurrentTransactionType);

            // POST FOR FLEX CHECKOUT PAYMENT TRANSACTION *******

            if (sessionResponse is null)
            {
                HandleErrorAndRedirect(null, "Session Response is null");
                return;
            }

            if (sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            bool responseContainsError = false;
            if (sessionResponse.TransactionJson is not null)
            {
                basicErrorInfos = JsonErrorExtractor.ExtractErrorObjects(sessionResponse.TransactionJson.ToString());

                responseContainsError = basicErrorInfos.Any(e =>
                    AppErrorConfig.ErrorKeywords.Any(k =>
                        $"{e.Status} {e.Reason} {e.Message} {e.Action}"
                            .ToLowerInvariant()
                            .Contains(k.ToLowerInvariant())
                    )
                );
            }

            if (responseContainsError)
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            _transactionJson = sessionResponse.TransactionJson;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/processfollowon");
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
            SessionTransJson sessionResponse = new();
            sessionResponse!.error = error;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/errorhandler");
        }
    }

