@page "/unifiedcheckout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))


@inject IHttpClientFactory httpClientFactory
@inject ICartService cartService
@inject ITransactionJson transactionJson
@inject NavigationManager Navigation

@inject ICustomersScoped customersScoped
@inject ISessionTransactions sessionTransactions

<h3>Unified Checkout</h3>

<div class="container">
    <main>

        @if (Show)
        {
            <CustomerMasterComponent ButtonText="Unified Checkout" FormElements="HomeFormElements" FormCustomer="b2CCustomer" ValidSubmit="Submit"></CustomerMasterComponent>
        }

        @if (error is not null)
        {
            <div class="row p-5">
                <stong class="alert-danger">@error</stong>
            </div>
            <br />
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
                Show Error Details
            </button>
            <br />
            <ErorrDetails TransactionJson="_transactionJson"></ErorrDetails>
        }
    </main>
</div>

<div>
    <footer class="my-5 pt-5 text-body-secondary text-center text-small">
        <p class="mb-1">&copy; 2017–2024 Company Name</p>
        <ul class="list-inline">
            <li class="list-inline-item"><a href="#">Privacy</a></li>
            <li class="list-inline-item"><a href="#">Terms</a></li>
            <li class="list-inline-item"><a href="#">Support</a></li>
        </ul>
    </footer>
</div>

@code {

    List<string> HomeFormElements = new List<string> { "ShowMainForm", "ShowBilling", "ShowDefaults", "ShowAuthCapture", "ShowCart" };

    public bool IsChecked { get; set; } = false;
    public bool CaptureChecked { get; set; } = false;
    public bool newTransaction { get; set; } = true;
    public bool Show { get; set; } = true;
    private bool containsError = false;

    private string? error;
    private string? combinedError;

    private DBSampleCustomerDatum? customer = new();
    private B2cCustomer b2CCustomer = new();

    private ICustomersScoped _customersScoped = new CustomersScoped();

    private static List<BasicErrorInfo> basicErrorInfos = new List<BasicErrorInfo>();
    private ISessionTransactions _sessionTransactions = new SessionTransactions();
    private SessionTransJson sessionTransJson = new();

    private JsonNode? _transactionJson = null;

    [Parameter, EditorRequired] public EventCallback<JsonNode> OnSelected { get; set; }


    protected override void OnInitialized()
    {
        sessionTransactions.DeleteAll();
    }

    private async Task Submit(B2cCustomer submittedCustomer)
    {
        try
        {
            B2cCustomer b2CCustomer = new();

            b2CCustomer.Address1 = submittedCustomer.Address1;
            b2CCustomer.Address2 = submittedCustomer.Address2 ?? null;
            b2CCustomer.Address3 = submittedCustomer.Address3 ?? null;
            b2CCustomer.AdministrativeArea = submittedCustomer.AdministrativeArea ?? "FU";
            b2CCustomer.Country = submittedCustomer.Country;
            b2CCustomer.BuildingNumber = submittedCustomer.BuildingNumber ?? "0";
            b2CCustomer.District = submittedCustomer.District ?? null;
            b2CCustomer.City = submittedCustomer.City;
            b2CCustomer.PostalCode = submittedCustomer.PostalCode;
            b2CCustomer.Email = submittedCustomer.Email;
            b2CCustomer.FirstName = submittedCustomer.FirstName;
            b2CCustomer.LastName = submittedCustomer.LastName;
            b2CCustomer.MiddleName = submittedCustomer.MiddleName ?? null;
            b2CCustomer.Title = submittedCustomer.Title ?? null;
            b2CCustomer.Phone = submittedCustomer.Phone;
            b2CCustomer.PhoneType = submittedCustomer.PhoneType ?? null;
            b2CCustomer.Email = submittedCustomer.Email;
            b2CCustomer.ShippingAddress1 = submittedCustomer.Address1;
            b2CCustomer.ShippingAddress2 = submittedCustomer.Address2 ?? null;
            b2CCustomer.ShippingAddress3 = submittedCustomer.Address3 ?? null;
            b2CCustomer.ShippingAdministrativeArea = submittedCustomer.AdministrativeArea ?? "FU";
            b2CCustomer.ShippingBuildingNumber = submittedCustomer.BuildingNumber ?? "0";
            b2CCustomer.ShippingCountry = submittedCustomer.Country;
            b2CCustomer.ShippingCity = submittedCustomer.City;
            b2CCustomer.Email = submittedCustomer.Email;
            b2CCustomer.ShippingPostalCode = submittedCustomer.PostalCode;
            b2CCustomer.ShippingFirstName = submittedCustomer.FirstName;
            b2CCustomer.ShippingLastName = submittedCustomer.LastName;
            b2CCustomer.ShippingPhone = submittedCustomer.Phone;
            b2CCustomer.ShippingPhoneType = submittedCustomer.PhoneType ?? null;
            b2CCustomer.TotalAmount = submittedCustomer.TotalAmount;
            b2CCustomer.Cart = submittedCustomer.Cart;
            b2CCustomer.TargetOrigin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);

            sessionTransJson.OriginalTransactionType = CcTransactionTypes.UNIFIED_CHECKOUT;
            sessionTransJson.CurrentTransactionType = CcTransactionTypes.UNIFIED_CHECKOUT;

            // Serialize the object into a string for submission

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(b2CCustomer, options);

            // POST FOR FOLLOW ON TRANSACTION *******

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString, 
                _sessionTransactions, (CcTransactionTypes)sessionTransJson.CurrentTransactionType!);

            // POST FOR FOLLOW ON TRANSACTION *******

            if (sessionResponse is null)
            {
                HandleErrorAndRedirect(null, "Session Response is null");
                return;
            }

            if (sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            if (sessionResponse is not null && sessionResponse.TransactionJson is not null && sessionResponse.TransactionStatus != "error")
            {
                basicErrorInfos = JsonErrorExtractor.ExtractErrorObjects(sessionResponse.TransactionJson.ToString());

                bool containsError = basicErrorInfos.Any(e =>
                    AppErrorConfig.ErrorKeywords.Any(k =>
                        $"{e.Status} {e.Reason} {e.Message} {e.Action}"
                            .ToLowerInvariant()
                            .Contains(k.ToLowerInvariant())
                    )
                );

            }

            if (containsError)
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            if (sessionResponse != null && containsError)
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }
            else
            {
                sessionTransactions.AddTrans(sessionResponse!);
                Navigation.NavigateTo("/unifiedprocessor");
            }
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
            SessionTransJson sessionResponse = new();
            sessionResponse!.error = error;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/errorhandler");
        }
    }

    private void HandleErrorAndRedirect(SessionTransJson? response, string fallbackErrorMessage = "Unknown error")
    {
        Show = false;
        StateHasChanged(); // optional UI refresh

        var errorMessage = response?.error ?? fallbackErrorMessage;
        var errorJsonState = response?.JsonTransactionStateValues ?? TransactionStateValues.Error;

        var errorResponse = response ?? new SessionTransJson
        {
            JsonTransactionStateValues = errorJsonState,
            error = errorMessage,
            TransactionStatus = "error"
        };

        sessionTransactions.AddTrans(errorResponse);
        Navigation.NavigateTo("/errorhandler");
    }
}
