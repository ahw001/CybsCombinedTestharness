@page "/store/blog"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Blog – CyberStore</PageTitle>

<StoreNavBar />

<div class="container py-5">
    <h1 class="display-4 fw-light mb-5" style="letter-spacing: -1.5px;">
        Latest <strong class="fw-bold">News</strong>
    </h1>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var post in _posts)
        {
            <div class="col">
                <div class="card h-100 border rounded-3">
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted small"
                         style="height: 200px;">
                        @post.Category
                    </div>
                    <div class="card-body">
                        <p class="text-uppercase text-muted small fw-semibold mb-1"
                           style="letter-spacing: 1px;">@post.Category</p>
                        <h5 class="card-title fw-semibold">@post.Title</h5>
                        <p class="card-text text-muted small">@post.Excerpt</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<StoreFooter />

@code {
    private readonly List<BlogPost> _posts = new()
    {
        new("Phones",   "MobileFirst Pro: Everything You Need to Know",          "The latest flagship redefines what a smartphone can do."),
        new("Gaming",   "GameConsole MAX 7 Review: A New Era of Gaming",          "Unprecedented power meets thoughtful design in this generation-defining console."),
        new("Laptops",  "LexBook Air vs LexBook Pro: Which Should You Buy?",      "We break down the differences to help you make the right choice."),
        new("Audio",    "The Science Behind Listen Max Computational Audio",      "How machine learning is transforming the way we experience sound."),
        new("Vision",   "Vision Pro: Six Months Later",                           "A deep dive into whether spatial computing has finally arrived."),
        new("Deals",    "Big Summer Sale: Our Top Picks Under $500",              "Amazing tech at incredible prices – our editors' top recommendations."),
    };

    private record BlogPost(string Category, string Title, string Excerpt);
}
