@page "/store/products"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using CybsClient.Services.DIServices
@using CybsClient.Services.Utilities
@inject IElectronicProductService ProductService

<PageTitle>Products – CyberStore</PageTitle>

<StoreNavBar />

<div class="container py-5">
    <h1 class="display-5 fw-light mb-4" style="letter-spacing: -1px;">
        Electronic <strong class="fw-bold">Products</strong>
    </h1>

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_products.Count == 0)
    {
        <p class="text-muted">No products found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in _products)
            {
                <div class="col">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-img-top text-center p-4 position-relative"
                             style="min-height: 200px; background: #f5f5f5;">
                            @if (!string.IsNullOrWhiteSpace(product.Picture))
                            {
                                <div class="d-flex align-items-center justify-content-center"
                                     style="height: 160px;">
                                    @PictureHelper.RenderProductImage(product.Picture,
                                        "max-width:100%;max-height:160px;object-fit:contain;")
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center"
                                     style="min-height: 160px;">
                                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body text-center d-flex flex-column">
                            <p class="card-title small fw-medium mb-1">@product.ProductLabel</p>
                            @if (!string.IsNullOrWhiteSpace(product.ProductSku))
                            {
                                <p class="text-muted small mb-1">SKU: @product.ProductSku</p>
                            }
                            <p class="fs-4 fw-bold mt-auto mb-3">
                                @(product.UnitPrice.HasValue ? $"${product.UnitPrice.Value:N2}" : "N/A")
                            </p>
                            <button class="btn btn-dark w-100">Add to Cart</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<StoreFooter />

@code {
    private List<ElectronicProduct> _products = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
