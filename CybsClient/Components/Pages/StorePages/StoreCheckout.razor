@page "/store/checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICartService cartService
@inject NavigationManager Navigation
@inject ISessionTransactions sessionTransactions
@inject IUnifiedCheckoutSettingsService UcSettings
@inject IJSRuntime JSRuntime
@inject ICardService cardService
@inject IPayerAuthTestCardService payerAuthTestCardService
@implements IDisposable

<script src="Components/Pages/StorePages/StoreCheckout.razor.js"></script>

<title>Store Checkout</title>

<div class="py-1 text-center">
    <h2>Store Checkout</h2>
</div>

<hr class="my-4" />

<div class="container">

    @if (Phase == CheckoutPhase.CustomerForm)
    {
        <div class="mb-3">
            <label class="form-label d-block fw-bold">Integration path</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ucIntegrationMode" id="modeV1"
                       checked="@(Mode == IntegrationMode.UnifiedV1)"
                       @onchange="@(() => Mode = IntegrationMode.UnifiedV1)" />
                <label class="form-check-label" for="modeV1">
                    Unified Checkout v1 (embedded — auto-processes unless the account is configured to return a transient token)
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ucIntegrationMode" id="modeV1Manual"
                       checked="@(Mode == IntegrationMode.UnifiedV1ManualToken)"
                       @onchange="@(() => Mode = IntegrationMode.UnifiedV1ManualToken)" />
                <label class="form-check-label" for="modeV1Manual">
                    Unified Checkout v1 — manual transient token ("Flow 3 / No Service Orchestration": <code>createCheckout({ autoProcessing: false })</code>; you submit the follow-on <code>/pts/v2/payments</code>)
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ucIntegrationMode" id="modeV0Manual"
                       checked="@(Mode == IntegrationMode.UnifiedV0ManualToken)"
                       @onchange="@(() => Mode = IntegrationMode.UnifiedV0ManualToken)" />
                <label class="form-check-label" for="modeV0Manual">
                    Unified Checkout v0 — manual transient token (widget returns the <code>transientTokenJwt</code>; you submit the follow-on <code>/pts/v2/payments</code>)
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="ucIntegrationMode" id="modeRest"
                       checked="@(Mode == IntegrationMode.RestBackup)"
                       @onchange="@(() => Mode = IntegrationMode.RestBackup)" />
                <label class="form-check-label" for="modeRest">
                    Simple REST API (backup — skip Unified Checkout)
                </label>
            </div>
        </div>

        @if (!UseRestBackup)
        {
            @if (UcSettings.SelectedConfig is not null)
            {
                <div class="alert alert-info">
                    Unified Checkout config: <strong>@UcSettings.SelectedConfig.Name</strong>
                    (<a href="/store/checkout-config">change</a>)
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    No Unified Checkout configuration selected — using a default Card-only configuration.
                    <a href="/store/checkout-config">Choose or save one</a>.
                </div>
            }
        }
    }

    <div class="row g-5">
        @if (Phase == CheckoutPhase.CustomerForm && Show)
        {
            <CustomerMasterComponent ButtonText="@(UseRestBackup ? "Checkout" : "Continue to Unified Checkout")"
                                      FormElements="CurrentFormElements"
                                      FormCustomer="b2CCustomer"
                                      ValidSubmit="Submit"></CustomerMasterComponent>
        }
        else if (Phase == CheckoutPhase.UnifiedCheckoutMount)
        {
            <div class="col-12">
                @if (ShowCardTestValues)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <label class="form-label">Test Card (select, then copy/paste into the Unified Checkout form below)</label>
                            <select class="form-select mb-2" value="@cardSelectValue" @onchange="OnTestCardSelected">
                                <option value="">-- Select a test card --</option>
                                <optgroup label="Standard Test Cards">
                                    @for (var i = 0; i < cardService.Cards.Count; i++)
                                    {
                                        var card = cardService.Cards[i];
                                        <option value="std:@i">@card.CardBrand @card.AccountNumber</option>
                                    }
                                </optgroup>
                                @foreach (var group in GroupedPaCards)
                                {
                                    <optgroup label="Payer Auth — @group.Key">
                                        @foreach (var card in group)
                                        {
                                            <option value="pa:@card.SamplePayAuthPaymentCardId">@card.OptionLabel</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            @if (selectedTestCardNumber is not null)
                            {
                                <div class="alert alert-info py-2 small mb-0">
                                    @ValueRow("Card number", selectedTestCardNumber)
                                    @ValueRow("Exp month", selectedTestCardExpMonth)
                                    @ValueRow("Exp year", selectedTestCardExpYear)
                                    @ValueRow("CVV", selectedTestCardCvv)
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (ShowECheckTestValues)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <label class="form-label">
                                eCheck Test Account (select, then copy/paste into the Unified Checkout
                                bank-account form below)
                            </label>
                            <select class="form-select mb-2" value="@echeckSelectValue"
                                    @onchange="OnECheckAccountSelected" disabled="@(echeckAccounts.Count == 0)">
                                <option value="">@ECheckPlaceholder</option>
                                @foreach (var group in GroupedECheckAccounts)
                                {
                                    <optgroup label="eCheck — @group.Key">
                                        @foreach (var account in group)
                                        {
                                            <option value="@account.ECheckTestAccountId">@account.DisplayLabel</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <small class="text-body-secondary d-block">
                                Seeded from CyberSource documentation. The Unified Checkout Echeck Test
                                Values page documents only routing number <code>071923284</code> with any
                                supported account number, so every row here is valid for the widget
                                whichever REST flow its category names.
                            </small>

                            @if (echeckLoadError is not null)
                            {
                                <div class="alert alert-warning py-2 small mt-2 mb-0">
                                    Could not load eCheck test accounts: @echeckLoadError
                                </div>
                            }
                            else if (selectedECheckRouting is not null)
                            {
                                <div class="alert alert-info py-2 small mt-2 mb-0">
                                    @ValueRow("Routing number", selectedECheckRouting)
                                    @ValueRow("Account number", selectedECheckAccountNumber)
                                    <div>Account type: <code>@DescribeAccountType(selectedECheckAccountType)</code></div>
                                    @if (!string.IsNullOrWhiteSpace(selectedECheckBankName))
                                    {
                                        <div>Bank name: <code>@selectedECheckBankName</code></div>
                                    }
                                    <div class="mt-2 text-body-secondary">
                                        Expected status: <code>@selectedECheckOutcome</code> — for eCheck,
                                        <strong>PENDING is the success status</strong>, not AUTHORIZED;
                                        ACH settlement is asynchronous.
                                    </div>
                                    <div class="text-body-secondary">
                                        SEC code
                                        @(string.IsNullOrWhiteSpace(selectedECheckSecCode)
                                            ? "(omitted on this row)"
                                            : $"({selectedECheckSecCode})")
                                        is informational only — Unified Checkout sets it itself and never
                                        asks the customer for one.
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div id="ucPaymentContainer" class="my-4">
                    <button type="button" class="btn btn-lg btn-block btn-primary" disabled="disabled">
                        Loading Unified Checkout...
                    </button>
                </div>

                @if (ucReady)
                {
                    <p class="text-muted">
                        @(Mode is IntegrationMode.UnifiedV0ManualToken or IntegrationMode.UnifiedV1ManualToken
                            ? "Complete the payment form above — the widget will return a transient token for the manual follow-on payment (nothing is charged yet)."
                            : "Complete your payment in the form above — this account processes the payment automatically once you confirm.")
                    </p>
                }

                <button class="btn btn-outline-secondary" @onclick="CancelUnifiedCheckout">
                    Cancel
                </button>
            </div>
        }
        else if (Phase == CheckoutPhase.TokenReceived)
        {
            <div class="col-12">
                <div class="alert alert-info">
                    <h4 class="alert-heading">Transient token received</h4>
                    <p class="mb-0">
                        The widget returned a <code>transientTokenJwt</code> without processing the payment.
                        Review the follow-on request below, then submit it to <code>/pts/v2/payments</code>.
                        Transient tokens expire 15 minutes after issuance.
                    </p>
                </div>

                <h6>Decoded transient token</h6>
                <pre class="bg-light p-3 border rounded small">@transientTokenDecodedJson</pre>

                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">
                            Follow-on request options (config: @(UcSettings.SelectedConfig?.Name ?? "default Card-only"))
                        </h6>
                        <ul class="mb-0 small">
                            <li>Amount: <strong>@FollowOnAmount USD</strong></li>
                            <li>actionList <code>TOKEN_CREATE</code>: <strong>@(FollowOnTokenCreate ? "yes" : "no")</strong></li>
                            <li>actionTokenTypes: <strong>@(FollowOnActionTokenTypes is { Length: > 0 } ? string.Join(", ", FollowOnActionTokenTypes) : "(none — merchant defaults apply)")</strong></li>
                            <li>orderInformation.billTo: <strong>@(IncludeBillTo ? "included from the customer form" : "omitted (token session data backs it)")</strong></li>
                            <li>orderInformation.shipTo: <strong>@(IncludeShipTo ? "included from the customer form" : "omitted entirely")</strong></li>
                        </ul>
                    </div>
                </div>

                <button class="btn btn-primary" disabled="@submittingTokenPayment" @onclick="SubmitTokenPayment">
                    @(submittingTokenPayment ? "Submitting..." : "Submit /pts/v2/payments")
                </button>
                <button class="btn btn-outline-secondary ms-2" disabled="@submittingTokenPayment" @onclick="CancelUnifiedCheckout">
                    Cancel
                </button>
            </div>
        }
        else if (Phase == CheckoutPhase.Completed)
        {
            <div class="col-12">
                <div class="alert alert-success">
                    <h4 class="alert-heading">Unified Checkout complete</h4>
                    <p>
                        @(manualCompletion
                            ? "The follow-on /pts/v2/payments call was submitted server-side with the transient token."
                            : "CyberSource processed this payment automatically as part of the embedded checkout flow.")
                    </p>
                </div>
                <pre class="bg-light p-3 border rounded">@completionResultJson</pre>
                <a class="btn btn-dark" href="/store">Continue Shopping</a>
            </div>
        }

        <FormSection>
            @if (error is not null)
            {
                <div class="col-6">
                    <strong class="alert-danger">@error</strong>
                </div>
            }
        </FormSection>
    </div>

    <footer class="my-5 pt-5 text-body-secondary text-center text-small">
        <p class="mb-1">&copy; 2017–2024 Company Name</p>
    </footer>
</div>

@code {
    private enum CheckoutPhase { CustomerForm, UnifiedCheckoutMount, TokenReceived, Completed }

    // v1 = embedded VAS.UnifiedCheckout (auto-processes under this account's Business Center
    // completeMandate default; auto-detects a returned transient token if that default is off);
    // v1 manual = same v1 session but createCheckout({ autoProcessing: false }) — the UC guide's
    // "Flow 3 / No Service Orchestration": mount() resolves with the transientTokenJwt, nothing
    // is processed, and the follow-on /pts/v2/payments is entirely ours. Live-verified
    // 2026-07-28: the client-side option overrides the merchant-level completeMandate default.
    // v0 manual = config-driven /up/v1/capture-contexts + SecureAcceptance.js, whose show()
    // resolves with the transientTokenJwt — the same manual contract on the v0 surface.
    private enum IntegrationMode { UnifiedV1, UnifiedV1ManualToken, UnifiedV0ManualToken, RestBackup }

    private static readonly List<string> UnifiedFormElements =
        new() { "ShowMainForm", "ShowBilling", "ShowDefaults", "ShowCart" };

    private static readonly List<string> RestFormElements =
        new() { "ShowMainForm", "ShowBilling", "ShowAccountDetails", "ShowDefaults", "ShowAuthCapture", "ShowCart" };

    private List<string> CurrentFormElements => UseRestBackup ? RestFormElements : UnifiedFormElements;

    private CheckoutPhase Phase = CheckoutPhase.CustomerForm;
    private IntegrationMode Mode { get; set; } = IntegrationMode.UnifiedV1;
    private bool UseRestBackup => Mode == IntegrationMode.RestBackup;
    private bool Show = true;
    private bool ucReady = false;
    private bool _pendingMount = false;

    private string? error;
    private string? completionResultJson;

    // ── Manual transient-token follow-on state ───────────────────────────────────────────
    private string? transientTokenJwt;
    private string? transientTokenDecodedJson;
    private bool submittingTokenPayment = false;
    private bool manualCompletion = false;

    private bool FollowOnTokenCreate => UcSettings.SelectedConfig?.EnableTms ?? false;

    private string[]? FollowOnActionTokenTypes =>
        string.IsNullOrWhiteSpace(UcSettings.SelectedConfig?.TmsTokenTypes)
            ? null
            : UcSettings.SelectedConfig!.TmsTokenTypes!
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private bool IncludeBillTo =>
        !string.Equals(UcSettings.SelectedConfig?.BillingType, "NONE", StringComparison.OrdinalIgnoreCase);

    private bool IncludeShipTo => UcSettings.SelectedConfig?.RequestShipping ?? true;

    private string FollowOnAmount =>
        (b2CCustomer.TotalAmount ?? cartService.Total ?? 0m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private B2cCustomer b2CCustomer = new();
    private CaptureContextDto captureContextDto = new();

    private ISessionTransactions _sessionTransactions = new SessionTransactions();
    private SessionTransJson sessionTransJson = new();

    private DotNetObjectReference<StoreCheckout>? _dotNetRef;

    // ── Test-value panels (copy/paste into the embedded Unified Checkout widget) ─────────
    // Which panels appear is driven by the active configuration's allowedPaymentTypes, because
    // that is exactly what decides which payment options the widget will offer the customer.
    // A null config means the server falls back to its own default Card-only capture context,
    // so the card panel stays visible in that case.
    private string[] AllowedPaymentTypes =>
        (UcSettings.SelectedConfig?.AllowedPaymentTypes ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private bool ShowCardTestValues =>
        AllowedPaymentTypes.Length == 0
        || AllowedPaymentTypes.Contains("PANENTRY", StringComparer.OrdinalIgnoreCase);

    private bool ShowECheckTestValues =>
        AllowedPaymentTypes.Contains("CHECK", StringComparer.OrdinalIgnoreCase);

    private string? cardSelectValue;
    private string? selectedTestCardNumber;
    private string? selectedTestCardExpMonth;
    private string? selectedTestCardExpYear;
    private string? selectedTestCardCvv;

    // Unlike the card lists — served from the cached ICardService/IPayerAuthTestCardService
    // hosted services — there is no DI cache for eCheck test accounts, so they are fetched once
    // through the CallMinAPIs gauntlet at the page's first render (kept out of the widget phase
    // so the server-side endpoint logging never lands mid-transaction during a demo).
    private string? echeckSelectValue;
    private List<ECheckTestAccountDto> echeckAccounts = new();
    private bool echeckLoadStarted;
    private bool echeckLoadCompleted;
    private string? echeckLoadError;

    private string? selectedECheckRouting;
    private string? selectedECheckAccountNumber;
    private string? selectedECheckAccountType;
    private string? selectedECheckBankName;
    private string? selectedECheckSecCode;
    private string? selectedECheckOutcome;

    // Label of the value most recently copied, so the row that was clicked can confirm it.
    private string? copiedLabel;

    private IEnumerable<IGrouping<string, PayerAuthTestCardDto>> GroupedPaCards =>
        payerAuthTestCardService.Cards
            .OrderBy(c => c.TestCaseId, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.CardBrand)
            .GroupBy(c => c.TestCaseGroupLabel);

    private IEnumerable<IGrouping<string, ECheckTestAccountDto>> GroupedECheckAccounts =>
        echeckAccounts.GroupBy(a => string.IsNullOrWhiteSpace(a.TestCategory) ? "OTHER" : a.TestCategory!);

    private string ECheckPlaceholder =>
        echeckLoadCompleted && echeckAccounts.Count == 0
            ? (echeckLoadError is not null ? "Test accounts unavailable" : "No test accounts found")
            : "-- Select a test account --";

    private static string DescribeAccountType(string? accountType) => accountType?.ToUpperInvariant() switch
    {
        "C" => "C — Checking",
        "S" => "S — Savings",
        "X" => "X — Corporate checking",
        _ => accountType ?? string.Empty
    };

    // One value row with its own copy button. The widget is cross-origin, so every one of these
    // values is otherwise transcribed by hand.
    private RenderFragment ValueRow(string label, string? value) =>
    @<div class="d-flex align-items-center gap-2 mb-1">
        <span class="text-nowrap">@label:</span>
        <code>@value</code>
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                title="Copy to clipboard" @onclick="() => CopyValue(label, value)">
            Copy
        </button>
        @if (copiedLabel == label)
        {
            <span class="text-success">copied</span>
        }
    </div>;

    private async Task CopyValue(string label, string? value)
    {
        if (string.IsNullOrEmpty(value)) return;

        var copied = await JSRuntime.InvokeAsync<bool>("storeCheckoutUC.copyText", value);

        copiedLabel = copied ? label : null;

        if (!copied)
        {
            Console.WriteLine($"[StoreCheckout] Clipboard copy failed for '{label}'.");
        }
    }

    // Only one set of values is ever on screen, so there is no ambiguity about which one the
    // widget's form is being filled from.
    private void ClearSelectedTestValues()
    {
        selectedTestCardNumber = selectedTestCardExpMonth = selectedTestCardExpYear = selectedTestCardCvv = null;

        selectedECheckRouting = selectedECheckAccountNumber = selectedECheckAccountType =
            selectedECheckBankName = selectedECheckSecCode = selectedECheckOutcome = null;

        copiedLabel = null;
    }

    private void OnTestCardSelected(ChangeEventArgs e)
    {
        ClearSelectedTestValues();

        var value = e.Value?.ToString();
        cardSelectValue = value;
        echeckSelectValue = string.Empty;

        if (string.IsNullOrWhiteSpace(value)) return;

        var parts = value.Split(':', 2);
        if (parts.Length != 2) return;

        if (parts[0] == "std" && int.TryParse(parts[1], out var index) && index >= 0 && index < cardService.Cards.Count)
        {
            var card = cardService.Cards[index];
            selectedTestCardNumber = card.AccountNumber;
            selectedTestCardExpMonth = card.ExpMonth;
            selectedTestCardExpYear = card.ExpYear;
            selectedTestCardCvv = card.Cvv;
        }
        else if (parts[0] == "pa" && int.TryParse(parts[1], out var id))
        {
            var card = payerAuthTestCardService.Cards.FirstOrDefault(c => c.SamplePayAuthPaymentCardId == id);
            if (card is not null)
            {
                selectedTestCardNumber = card.AccountNumber;
                selectedTestCardExpMonth = card.ExpMonth;
                selectedTestCardExpYear = card.ExpYear;
                selectedTestCardCvv = card.Cvv;
            }
        }
    }

    private void OnECheckAccountSelected(ChangeEventArgs e)
    {
        ClearSelectedTestValues();

        var value = e.Value?.ToString();
        echeckSelectValue = value;
        cardSelectValue = string.Empty;

        if (string.IsNullOrWhiteSpace(value) || !int.TryParse(value, out var id)) return;

        var account = echeckAccounts.FirstOrDefault(a => a.ECheckTestAccountId == id);
        if (account is null) return;

        selectedECheckRouting = account.RoutingNumber;
        selectedECheckAccountNumber = account.AccountNumber;
        selectedECheckAccountType = account.AccountType;
        selectedECheckBankName = account.BankName;
        selectedECheckSecCode = account.SecCode;
        selectedECheckOutcome = account.ScenarioOutcome;
    }

    private async Task LoadECheckTestAccounts()
    {
        var result = await CallMinAPIs.GetECheckTestAccountsAsync();

        if (result.Error is not null)
        {
            // A failed lookup degrades this panel only: the widget's own bank-account form is
            // still hand-fillable, so the checkout itself is unaffected.
            echeckLoadError = result.Error.Message ?? result.Error.Error;
            Console.WriteLine($"[StoreCheckout] eCheck test account load failed: {echeckLoadError}");
        }
        else
        {
            echeckAccounts = result.Data ?? new List<ECheckTestAccountDto>();
        }

        echeckLoadCompleted = true;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);

        if (cartService.Cart is not null && cartService.Cart.Count > 0)
        {
            b2CCustomer.Cart = cartService.Cart.ToList();
            b2CCustomer.TotalAmount = cartService.Total;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingMount && Phase == CheckoutPhase.UnifiedCheckoutMount)
        {
            _pendingMount = false;

            var clientLibraryUrl = ExtractClientLibrary(captureContextDto.Ctx);

            // Both ctx flavors carry ctx[0].data.clientLibrary — SecureAcceptance.js for the
            // v0-manual mode, UnifiedCheckout.js for v1. The final argument asks the v1 SDK for
            // createCheckout({ autoProcessing: false }) — the Flow 3 manual-token mode.
            if (Mode == IntegrationMode.UnifiedV0ManualToken)
            {
                await JSRuntime.InvokeVoidAsync(
                    "storeCheckoutUC.loadV0ScriptAndMount",
                    _dotNetRef, captureContextDto.Ctx, clientLibraryUrl, "ucPaymentContainer");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync(
                    "storeCheckoutUC.loadScriptAndMount",
                    _dotNetRef, captureContextDto.Ctx, clientLibraryUrl, "ucPaymentContainer",
                    Mode == IntegrationMode.UnifiedV1ManualToken);
            }
        }

        // Fetched at first render — not when the widget phase starts — so the server console
        // shows this reference-data call at page load instead of interleaved between the demo's
        // /uc/v1/sessions and /pts/v2/payments logging. The config (and therefore whether CHECK
        // is allowed) cannot change while this page is up, so firstRender is a safe gate.
        // echeckLoadStarted is set before awaiting, so a failed load reports itself once.
        if (firstRender && ShowECheckTestValues && !echeckLoadStarted)
        {
            echeckLoadStarted = true;
            await LoadECheckTestAccounts();
        }
    }

    // Live E2E verification (2026-07-21) confirmed clientLibrary is NOT a top-level JWT claim —
    // System.IdentityModel.Tokens.Jwt's flat Claims enumeration (JWTItems.DecodeJWT) never finds
    // it. The real capture-context JWT payload shape is: { "ctx": [ { "data": { ...,
    // "clientLibrary": "https://.../SecureAcceptance.js" }, "type": "..." } ], "iss": ..., ... }.
    // Decode the payload segment directly and walk to ctx[0].data.clientLibrary instead.
    // Base64url-decodes a JWT's payload segment (index 1) to raw JSON text. Shared by
    // ExtractClientLibrary (capture-context JWT) and OnUnifiedCheckoutComplete (mount()
    // completion JWT) below.
    private static string? DecodeJwtPayload(string? jwt)
    {
        if (string.IsNullOrWhiteSpace(jwt)) return null;
        var parts = jwt.Split('.');
        if (parts.Length < 2) return null;

        try
        {
            string padded = parts[1].Replace('-', '+').Replace('_', '/');
            switch (padded.Length % 4)
            {
                case 2: padded += "=="; break;
                case 3: padded += "="; break;
            }

            return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded));
        }
        catch
        {
            return null;
        }
    }

    private static string? ExtractClientLibrary(string? jwt)
    {
        var json = DecodeJwtPayload(jwt);
        if (json is null) return null;

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("ctx", out var ctxArray) &&
                ctxArray.ValueKind == JsonValueKind.Array &&
                ctxArray.GetArrayLength() > 0 &&
                ctxArray[0].TryGetProperty("data", out var data) &&
                data.TryGetProperty("clientLibrary", out var nestedLib))
            {
                return nestedLib.GetString();
            }

            // Fallback in case a future/older response shape puts it top-level.
            if (root.TryGetProperty("clientLibrary", out var topLib))
            {
                return topLib.GetString();
            }

            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[StoreCheckout] Failed to extract clientLibrary from capture context JWT: {ex.Message}");
            return null;
        }
    }

    // ── Step 1: collect customer/billing/shipping/cart, then either go to Unified Checkout
    //            or the simple REST backup ────────────────────────────────────────────────

    private async Task Submit(B2cCustomer submittedCustomer)
    {
        if (UseRestBackup)
        {
            await SubmitRestBackup(submittedCustomer);
        }
        else
        {
            await SubmitUnifiedCheckout(submittedCustomer);
        }
    }

    private async Task SubmitUnifiedCheckout(B2cCustomer submittedCustomer)
    {
        try
        {
            B2cCustomer requestCustomer = new();

            requestCustomer.Address1 = submittedCustomer.Address1;
            requestCustomer.Address2 = submittedCustomer.Address2;
            requestCustomer.Address3 = submittedCustomer.Address3;
            requestCustomer.AdministrativeArea = submittedCustomer.AdministrativeArea ?? "FU";
            requestCustomer.Country = submittedCustomer.Country;
            requestCustomer.BuildingNumber = submittedCustomer.BuildingNumber ?? "0";
            requestCustomer.District = submittedCustomer.District;
            requestCustomer.City = submittedCustomer.City;
            requestCustomer.PostalCode = submittedCustomer.PostalCode;
            requestCustomer.Email = submittedCustomer.Email;
            requestCustomer.FirstName = submittedCustomer.FirstName;
            requestCustomer.LastName = submittedCustomer.LastName;
            requestCustomer.MiddleName = submittedCustomer.MiddleName;
            requestCustomer.Title = submittedCustomer.Title;
            requestCustomer.Phone = submittedCustomer.Phone;
            requestCustomer.PhoneType = submittedCustomer.PhoneType;

            // Goal 1 uses full billing+shipping — shipping mirrors billing, same as the legacy
            // /unifiedcheckout page, until Execution Goal 3 makes shipping independently optional.
            requestCustomer.ShippingAddress1 = submittedCustomer.Address1;
            requestCustomer.ShippingAddress2 = submittedCustomer.Address2;
            requestCustomer.ShippingAddress3 = submittedCustomer.Address3;
            requestCustomer.ShippingAdministrativeArea = submittedCustomer.AdministrativeArea ?? "FU";
            requestCustomer.ShippingBuildingNumber = submittedCustomer.BuildingNumber ?? "0";
            requestCustomer.ShippingCountry = submittedCustomer.Country;
            requestCustomer.ShippingCity = submittedCustomer.City;
            requestCustomer.ShippingPostalCode = submittedCustomer.PostalCode;
            requestCustomer.ShippingFirstName = submittedCustomer.FirstName;
            requestCustomer.ShippingLastName = submittedCustomer.LastName;
            requestCustomer.ShippingPhone = submittedCustomer.Phone;
            requestCustomer.ShippingPhoneType = submittedCustomer.PhoneType;

            requestCustomer.TotalAmount = submittedCustomer.TotalAmount;
            requestCustomer.Cart = submittedCustomer.Cart;
            requestCustomer.TargetOrigin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
            requestCustomer.UnifiedCheckoutConfigurationId = UcSettings.SelectedConfig?.UnifiedCheckoutConfigurationId;

            // v1 default: real Unified Checkout session (uc/v1/sessions). v0-manual mode: the
            // config-driven /up/v1/capture-contexts variant whose widget returns the transient
            // token. Both are deliberately NOT CcTransactionTypes.UNIFIED_CHECKOUT, which is the
            // legacy /unifiedcheckout page's type and stays wired to /api/tokens/capturecontext
            // unchanged.
            var sessionType = Mode == IntegrationMode.UnifiedV0ManualToken
                ? CcTransactionTypes.UNIFIED_CHECKOUT_V0_CONTEXT
                : CcTransactionTypes.UNIFIED_CHECKOUT_V1;

            sessionTransJson.OriginalTransactionType = sessionType;
            sessionTransJson.CurrentTransactionType = sessionType;

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(requestCustomer, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, sessionType);

            if (sessionResponse is null)
            {
                HandleErrorAndRedirect(null, "Session Response is null");
                return;
            }

            if (sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            captureContextDto = JsonSerializer.Deserialize<CaptureContextDto>(sessionResponse.TransactionJson)
                ?? new CaptureContextDto();

            if (string.IsNullOrWhiteSpace(captureContextDto.Ctx))
            {
                HandleErrorAndRedirect(sessionResponse, "Capture context did not include a JWT.");
                return;
            }

            b2CCustomer = requestCustomer;
            sessionTransactions.AddTrans(sessionResponse);

            Phase = CheckoutPhase.UnifiedCheckoutMount;
            _pendingMount = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
            SessionTransJson sessionResponse = new();
            sessionResponse!.error = error;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/errorhandler");
        }
    }

    // ── Step 2: Unified Checkout JS mounted — wait for the customer to complete payment
    //            entry, then finalize and post the transient token ───────────────────────

    [JSInvokable]
    public void OnUnifiedCheckoutReady()
    {
        ucReady = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnUnifiedCheckoutError(string message)
    {
        error = "Unified Checkout error: " + message;
        StateHasChanged();
    }

    private void CancelUnifiedCheckout()
    {
        Phase = CheckoutPhase.CustomerForm;
        ucReady = false;
        transientTokenJwt = null;
        transientTokenDecodedJson = null;
        manualCompletion = false;
        StateHasChanged();
    }

    // ── Manual transient-token handling (both vehicles land here) ───────────────────────

    // v0 SecureAcceptance path: show()'s promise resolved with the raw transientTokenJwt.
    [JSInvokable]
    public void ReceiveV0TransientToken(string token)
    {
        EnterTokenReceived(token);
    }

    // A transient token payload is { iss: "Flex/08", content: { paymentInformation: ... }, ... }
    // with no top-level transaction outcome; an autoProcessing completion payload carries
    // status/outcome at the top level and no content node. This distinction is what lets the
    // v1 path auto-detect a non-autoProcessing account (Business Center completeMandate default
    // removed) without any configuration.
    private static bool IsTransientTokenPayload(string payloadJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            var root = doc.RootElement;
            return root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("content", out var content)
                && content.ValueKind == JsonValueKind.Object
                && content.TryGetProperty("paymentInformation", out _)
                && !root.TryGetProperty("status", out _);
        }
        catch
        {
            return false;
        }
    }

    private void EnterTokenReceived(string tokenJwt)
    {
        transientTokenJwt = tokenJwt;
        transientTokenDecodedJson = tokenJwt;

        var payloadJson = DecodeJwtPayload(tokenJwt);
        if (payloadJson is not null)
        {
            // DeepPretty rather than a bare WriteIndented serialize — see the note in
            // SubmitTokenPayment. It also falls back to the raw string if this doesn't parse,
            // which is why the JsonException guard is gone.
            transientTokenDecodedJson = JsonLogFormatter.DeepPretty(payloadJson);
        }

        Console.WriteLine($"[StoreCheckout] Transient token received (manual mode) — decoded payload:\n{transientTokenDecodedJson}");

        ucReady = false;
        Phase = CheckoutPhase.TokenReceived;
        StateHasChanged();
    }

    // This account has a merchant-level completeMandate default (confirmed live 2026-07-21:
    // the capture-context JWT already carries a completeMandate object we never requested),
    // which puts the v1 SDK in "autoProcessing" mode — CyberSource processes the payment itself
    // client-side (a real POST to testflex.cybersource.com/flex/v2/complete, confirmed via the
    // browser's network log) and checkout.mount()'s promise only resolves once that finishes.
    // There is no separate "complete" event or manual complete() call for this mode — calling
    // checkout.complete() throws ("cannot be called when autoProcessing is enabled").
    [JSInvokable]
    public void OnUnifiedCheckoutComplete(string resultJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(resultJson);
            var root = doc.RootElement;

            // checkout.mount()'s resolved value is itself a signed JWT, not a JSON object —
            // decode its payload so the completion screen shows the real transaction outcome
            // (status/approvalCode/etc.) instead of the raw encoded token.
            if (root.ValueKind == JsonValueKind.String)
            {
                var jwt = root.GetString();
                var payloadJson = DecodeJwtPayload(jwt);

                // With autoProcessing OFF (no Business Center completeMandate default), the v1
                // SDK's mount() resolves with the TRANSIENT TOKEN itself rather than a processed
                // result — detect that shape and hand off to the manual follow-on flow instead
                // of treating it as a completion.
                if (jwt is not null && payloadJson is not null && IsTransientTokenPayload(payloadJson))
                {
                    EnterTokenReceived(jwt);
                    return;
                }

                completionResultJson = payloadJson is not null
                    ? JsonLogFormatter.DeepPretty(payloadJson)
                    : jwt;
            }
            else
            {
                completionResultJson = JsonLogFormatter.DeepPretty(resultJson);
            }
        }
        catch (JsonException)
        {
            completionResultJson = resultJson;
        }

        Console.WriteLine($"[StoreCheckout] Unified Checkout auto-processed result:\n{completionResultJson}");

        cartService.DeleteAll();
        Phase = CheckoutPhase.Completed;
        StateHasChanged();
    }

    // ── Step 3 (manual mode): submit the follow-on /pts/v2/payments with the transient
    //    token, options resolved from the active UnifiedCheckoutConfiguration ────────────

    private async Task SubmitTokenPayment()
    {
        if (string.IsNullOrWhiteSpace(transientTokenJwt) || submittingTokenPayment) return;

        submittingTokenPayment = true;
        StateHasChanged();

        try
        {
            var dto = new UnifiedTokenPaymentDto
            {
                ClientReferenceCode = Guid.NewGuid().ToString(),
                TransientTokenJwt = transientTokenJwt,
                TotalAmount = FollowOnAmount,
                Currency = "USD",
                EnableTokenCreate = FollowOnTokenCreate,
                ActionTokenTypes = FollowOnActionTokenTypes,
                BillTo = !IncludeBillTo ? null : new BillTo
                {
                    FirstName = b2CCustomer.FirstName,
                    LastName = b2CCustomer.LastName,
                    Address1 = b2CCustomer.Address1,
                    Address2 = b2CCustomer.Address2,
                    Locality = b2CCustomer.City,
                    AdministrativeArea = b2CCustomer.AdministrativeArea,
                    PostalCode = b2CCustomer.PostalCode,
                    Country = b2CCustomer.Country,
                    Email = b2CCustomer.Email,
                    PhoneNumber = b2CCustomer.Phone
                },
                ShipTo = !IncludeShipTo ? null : new BillTo
                {
                    FirstName = b2CCustomer.ShippingFirstName ?? b2CCustomer.FirstName,
                    LastName = b2CCustomer.ShippingLastName ?? b2CCustomer.LastName,
                    Address1 = b2CCustomer.ShippingAddress1 ?? b2CCustomer.Address1,
                    Address2 = b2CCustomer.ShippingAddress2 ?? b2CCustomer.Address2,
                    Locality = b2CCustomer.ShippingCity ?? b2CCustomer.City,
                    AdministrativeArea = b2CCustomer.ShippingAdministrativeArea ?? b2CCustomer.AdministrativeArea,
                    PostalCode = b2CCustomer.ShippingPostalCode ?? b2CCustomer.PostalCode,
                    Country = b2CCustomer.ShippingCountry ?? b2CCustomer.Country
                }
            };

            sessionTransJson.OriginalTransactionType = CcTransactionTypes.UNIFIED_CHECKOUT_TOKEN_PAYMENT;
            sessionTransJson.CurrentTransactionType = CcTransactionTypes.UNIFIED_CHECKOUT_TOKEN_PAYMENT;

            var options = new JsonSerializerOptions { WriteIndented = true, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(dto, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, CcTransactionTypes.UNIFIED_CHECKOUT_TOKEN_PAYMENT);

            if (sessionResponse is null)
            {
                HandleErrorAndRedirect(null, "Session Response is null");
                return;
            }

            if (sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            // Same embedded-error scan the REST backup path runs — a DECLINED/INVALID_DATA
            // payment comes back 2XX with the error inside the JSON.
            var basicErrorInfos = JsonErrorExtractor.ExtractErrorObjects(sessionResponse.TransactionJson?.ToString() ?? string.Empty);
            bool containsError = basicErrorInfos.Any(e =>
                AppErrorConfig.ErrorKeywords.Any(k =>
                    $"{e.Status} {e.Reason} {e.Message} {e.Action}".ToLowerInvariant().Contains(k.ToLowerInvariant())));

            if (containsError)
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse);

            // DeepPretty, not a bare WriteIndented serialize: this response carries a nested
            // "cybersourceJson" string holding the raw CyberSource body, which WriteIndented
            // leaves as one escaped single line (a unicode escape for every quote). DeepPretty expands
            // embedded JSON strings in place and uses the relaxed encoder, so nothing is
            // dropped — the raw body can carry fields the outer DTO doesn't model.
            completionResultJson = sessionResponse.TransactionJson is null
                ? "{}"
                : JsonLogFormatter.DeepPretty(sessionResponse.TransactionJson.ToJsonString());

            Console.WriteLine($"[StoreCheckout] Manual transient-token payment result:\n{completionResultJson}");

            manualCompletion = true;
            cartService.DeleteAll();
            Phase = CheckoutPhase.Completed;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
            SessionTransJson sessionResponse = new();
            sessionResponse!.error = error;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/errorhandler");
        }
        finally
        {
            submittingTokenPayment = false;
        }
    }

    // ── Simple REST API backup path — reuses the existing SALE/AUTH flow, same as the
    //    legacy /checkout page's Submit() ──────────────────────────────────────────────

    private async Task SubmitRestBackup(B2cCustomer submittedCustomer)
    {
        try
        {
            if (submittedCustomer.MarkedForCapture)
            {
                sessionTransJson.OriginalTransactionType = CcTransactionTypes.SALE;
                sessionTransJson.CurrentTransactionType = CcTransactionTypes.SALE;
            }
            else
            {
                sessionTransJson.OriginalTransactionType = CcTransactionTypes.AUTH;
                sessionTransJson.CurrentTransactionType = CcTransactionTypes.AUTH;
            }

            submittedCustomer.ActionTokenTypes ??= new string[] { "paymentInstrument" };

            if (submittedCustomer.TotalAmount == 0.00m && submittedCustomer.Cart is not null)
            {
                foreach (var item in submittedCustomer.Cart)
                {
                    submittedCustomer.TotalAmount += item.UnitPrice;
                }
            }

            var options = new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping, DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
            string jsonString = JsonSerializer.Serialize(submittedCustomer, options);

            SessionTransJson sessionResponse = await CallMinAPIs.SubmitForFollowOn(jsonString,
                sessionTransactions, (CcTransactionTypes)sessionTransJson.CurrentTransactionType!);

            if (sessionResponse is null)
            {
                HandleErrorAndRedirect(null, "Session Response is null");
                return;
            }

            if (sessionResponse.TransactionStatus == "error")
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            var basicErrorInfos = JsonErrorExtractor.ExtractErrorObjects(sessionResponse.TransactionJson?.ToString() ?? string.Empty);
            bool containsError = basicErrorInfos.Any(e =>
                AppErrorConfig.ErrorKeywords.Any(k =>
                    $"{e.Status} {e.Reason} {e.Message} {e.Action}".ToLowerInvariant().Contains(k.ToLowerInvariant())));

            if (containsError)
            {
                HandleErrorAndRedirect(sessionResponse);
                return;
            }

            sessionTransactions.AddTrans(sessionResponse!);
            cartService.DeleteAll();
            Navigation.NavigateTo("/processauth");
        }
        catch (Exception ex)
        {
            error = "Error: " + ex.Message;
            SessionTransJson sessionResponse = new();
            sessionResponse!.error = error;
            sessionTransactions.AddTrans(sessionResponse);
            Navigation.NavigateTo("/errorhandler");
        }
    }

    private void HandleErrorAndRedirect(SessionTransJson? response, string fallbackErrorMessage = "Unknown error")
    {
        Phase = CheckoutPhase.CustomerForm;
        Show = false;
        StateHasChanged();

        var errorMessage = response?.error ?? fallbackErrorMessage;
        var errorJsonState = response?.JsonTransactionStateValues ?? TransactionStateValues.Error;

        var errorResponse = response ?? new SessionTransJson
        {
            JsonTransactionStateValues = errorJsonState,
            error = errorMessage,
            TransactionStatus = "error"
        };

        sessionTransactions.AddTrans(errorResponse);
        Navigation.NavigateTo("/errorhandler");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
