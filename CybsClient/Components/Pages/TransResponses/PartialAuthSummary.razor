@rendermode @(new InteractiveServerRenderMode(prerender: false))
@page "/partialauthsummary"

@inject ISessionTransactions sessionTransactions
@inject NavigationManager Navigation

<title>Partial Authorization Summary</title>

<div class="container py-4">
    <h2 class="mb-4">Partial Authorization — Transaction Summary</h2>

    @if (authSegments.Count > 0)
    {
        <div class="alert alert-success shadow-sm mb-4" role="alert">
            <h5 class="alert-heading"><i class="bi bi-check-circle-fill me-2"></i>All Payments Completed</h5>
            <p>The following authorizations were processed to cover the full order amount.</p>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Transaction ID</th>
                        <th>Status</th>
                        <th>Authorized Amount</th>
                        <th>Transaction Type</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < authSegments.Count; i++)
                    {
                        var seg = authSegments[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="text-break" style="max-width: 250px;">@seg.TransactionId</td>
                            <td>
                                @if (string.Equals(seg.TransactionType, "PARTIAL_AUTHORIZED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                }
                                else if (string.Equals(seg.TransactionType, "AUTHORIZED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">Authorized</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@seg.TransactionType</span>
                                }
                            </td>
                            <td>$@(seg.TransactionAmount ?? "0.00")</td>
                            <td>@seg.CurrentTransactionType</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info fw-bold">
                        <td colspan="3" class="text-end">Total Authorized:</td>
                        <td>$@totalAuthorized.ToString("F2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>No authorization transactions found in the current session.</p>
        </div>
    }

    <div class="d-flex gap-2 mt-4">
        <a href="checkout" class="btn btn-primary">
            <i class="bi bi-cart me-1"></i>New Checkout
        </a>
    </div>
</div>

@code {
    private List<SessionTransJson> authSegments = new();
    private decimal totalAuthorized = 0m;

    protected override void OnInitialized()
    {
        if (sessionTransactions?.Transactions is not null)
        {
            // Collect all AUTH/SALE/PARTIAL_AUTH_BALANCE transactions from the session
            authSegments = sessionTransactions.Transactions
                .Where(t => t.CurrentTransactionType == CcTransactionTypes.AUTH
                    || t.CurrentTransactionType == CcTransactionTypes.SALE
                    || t.CurrentTransactionType == CcTransactionTypes.PARTIAL_AUTH_BALANCE)
                .Where(t => t.JsonTransactionStateValues == TransactionStateValues.Complete)
                .ToList();

            foreach (var seg in authSegments)
            {
                if (decimal.TryParse(seg.TransactionAmount, out decimal amt))
                {
                    totalAuthorized += amt;
                }
            }
        }

        base.OnInitialized();
    }
}
