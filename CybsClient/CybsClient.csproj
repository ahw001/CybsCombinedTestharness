<Project Sdk="Microsoft.NET.Sdk.Web">
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  
  <PropertyGroup>
	  <AssemblyName>CybsClient</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Remove="Components\Pages\SecureAcceptance\**" />
    <Content Remove="Components\Pages\SecureAcceptance\**" />
    <EmbeddedResource Remove="Components\Pages\SecureAcceptance\**" />
    <None Remove="Components\Pages\SecureAcceptance\**" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Remove="wwwroot\favicon.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="Components\Pages\PageUtils\JavaScriptTest.razor.js" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Components\Pages\JSInteropTesting\JavaScriptTest.razor.js" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="wwwroot\favicon.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CybsClass.WebApi.Service\CybsClass.WebApi.Service.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Update="Components\Pages\AftProcessing\AftProcessor.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Update="Components\Pages\CloudPos\CloudPosCaputre.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Update="Components\Pages\CloudPos\CloudPosTokenReturn.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Resource\localhost.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Update="urlEndpoints.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Update="apiLogSuppression.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Pages\PaybyLink\" />
  </ItemGroup>

</Project>
